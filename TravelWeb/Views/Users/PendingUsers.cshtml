@model List<TravelWeb.Models.User>
@{
    ViewData["Title"] = "Tài khoản chờ phê duyệt";
}

<h2 class="text-center mt-4">
    <i class="bi bi-clock-history"></i> Tài khoản chờ phê duyệt
</h2>

<div class="container mt-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách User
        </a>
        <a asp-action="Index" asp-controller="Tours" class="btn btn-primary">
            <i class="bi bi-house-door"></i> Về trang chủ
        </a>
    </div>

    @if (Model != null && Model.Count > 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle-fill"></i> 
            Có <strong>@Model.Count</strong> tài khoản đang chờ phê duyệt
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>Email</th>
                        <th>Số điện thoại</th>
                        <th>Role</th>
                        <th style="text-align: center;">Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        // Parse email thật từ Phone field
                        var displayEmail = "N/A";
                        var displayPhone = "N/A";
                        
                        if (!string.IsNullOrEmpty(user.Phone) && user.Phone.StartsWith("EMAIL:"))
                        {
                            var parts = user.Phone.Split("|");
                            displayEmail = parts[0].Replace("EMAIL:", "");
                            if (parts.Length > 1)
                            {
                                displayPhone = parts[1].Replace("PHONE:", "");
                            }
                        }
                        
                        <tr>
                            <td><strong>@user.Id</strong></td>
                            <td>
                                <i class="bi bi-person-circle"></i> 
                                <strong>@user.Username</strong>
                            </td>
                            <td>@(user.FullName ?? "Chưa cập nhật")</td>
                            <td>
                                <small>
                                    <i class="bi bi-envelope"></i> @displayEmail
                                </small>
                            </td>
                            <td>
                                <small>
                                    <i class="bi bi-telephone"></i> @displayPhone
                                </small>
                            </td>
                            <td>
                                @{
                                    var roleBadgeClass = user.Role switch
                                    {
                                        "Hotel" => "bg-info",
                                        "Flight" => "bg-primary",
                                        "Train" => "bg-warning",
                                        "Bus" => "bg-success",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @roleBadgeClass">@user.Role</span>
                            </td>
                            <td style="text-align: center;">
                                <form method="post" asp-action="ApproveUser" asp-controller="Users" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" 
                                            class="btn btn-sm btn-success" 
                                            onclick="return confirm('✅ Xác nhận phê duyệt tài khoản @user.Username?')">
                                        <i class="bi bi-check-circle"></i> Duyệt
                                    </button>
                                </form>

                                <form method="post" asp-action="RejectUser" asp-controller="Users" style="display: inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" 
                                            class="btn btn-sm btn-danger" 
                                            onclick="return confirm('❌ Xác nhận từ chối tài khoản @user.Username?')">
                                        <i class="bi bi-x-circle"></i> Từ chối
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-success text-center py-5">
            <i class="bi bi-check-circle" style="font-size: 48px;"></i>
            <h4 class="mt-3">Không có tài khoản chờ duyệt</h4>
            <p class="text-muted">Tất cả tài khoản đã được xử lý</p>
            <a asp-action="Index" class="btn btn-primary mt-3">
                <i class="bi bi-list"></i> Xem tất cả User
            </a>
        </div>
    }
</div>

<style>
    .table thead th {
        vertical-align: middle;
        white-space: nowrap;
    }
    
    .table tbody td {
        vertical-align: middle;
    }
    
    .btn-sm {
        padding: 0.25rem 0.75rem;
        font-size: 0.875rem;
    }
    
    .alert i {
        margin-right: 0.5rem;
    }
</style>