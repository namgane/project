@model TravelWeb.Models.TripRequest
@{
    ViewData["Title"] = "Trip Planner - Lập kế hoạch du lịch thông minh";
}

<div class="container-fluid px-0">
    <div class="hero-section bg-gradient-primary text-white py-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4">🗺️ Trip Planner</h1>
                    <p class="lead mb-4">Lập kế hoạch du lịch thông minh. Chỉ cần nhập địa điểm và ngân sách, chúng tôi sẽ tạo cho bạn một lịch trình hoàn hảo!</p>
                    <div class="d-flex flex-wrap gap-3">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-2"></i>
                            <span>Lịch trình chi tiết</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-2"></i>
                            <span>Tính toán chi phí</span>
                        </div>
                        <div class="d-flex align-items-center">
                            <i class="fas fa-check-circle me-2"></i>
                            <span>Gợi ý phương tiện</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <i class="fas fa-route fa-10x opacity-75"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="container my-5">
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="row justify-content-center mb-4">
                <div class="col-lg-8">
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        @if (TempData["InfoMessage"] != null)
        {
            <div class="row justify-content-center mb-4">
                <div class="col-lg-8">
                    <div class="alert alert-info alert-dismissible fade show" role="alert">
                        <i class="fas fa-info-circle me-2"></i>
                        @TempData["InfoMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                </div>
            </div>
        }

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"
             style="@(ViewContext.ModelState.IsValid ? "display:none;" : "")">
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-white border-0 py-4">
                        <h3 class="text-center mb-0">
                            <i class="fas fa-map-marked-alt text-primary me-2"></i>
                            Tạo kế hoạch du lịch
                        </h3>
                        <p class="text-muted text-center mt-2">Điền thông tin để nhận lịch trình du lịch tối ưu</p>
                    </div>
                    <div class="card-body p-5">
                        <form method="post" asp-action="Index" id="tripForm" novalidate>
                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label for="Destination" class="form-label fw-bold">
                                        <i class="fas fa-map-marker-alt text-primary me-2"></i>Địa điểm du lịch
                                    </label>
                                    <input type="text"
                                           class="form-control form-control-lg"
                                           id="Destination"
                                           name="Destination"
                                           placeholder="Ví dụ: Đà Lạt, Hội An, Phú Quốc..."
                                           value="@Model?.Destination"
                                           required>
                                    <span asp-validation-for="Destination" class="text-danger"></span>
                                    <div class="form-text">Nhập tên thành phố hoặc địa điểm bạn muốn đến</div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label for="Budget" class="form-label fw-bold">
                                        <i class="fas fa-wallet text-success me-2"></i>Ngân sách (VNĐ)
                                    </label>
                                    <div class="input-group">
                                        <input type="number"
                                               class="form-control form-control-lg"
                                               id="Budget"
                                               name="Budget"
                                               placeholder="5,000,000"
                                               value="@Model?.Budget"
                                               min="1000000"
                                               step="100000"
                                               required>
                                        <span class="input-group-text">VNĐ</span>
                                    </div>
                                    <span asp-validation-for="Budget" class="text-danger"></span>
                                    <div class="form-text">Ngân sách tối thiểu: 1,000,000 VNĐ</div>
                                    <div class="form-text">Ngân sách tối đa: 15,000,000 VNĐ</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label for="Days" class="form-label fw-bold">
                                        <i class="fas fa-calendar-alt text-info me-2"></i>Số ngày du lịch
                                    </label>
                                    <input type="number"
                                           class="form-control form-control-lg"
                                           id="Days"
                                           name="Days"
                                           placeholder="Để trống để tụi tôi gợi ý"
                                           value="@Model?.Days"
                                           min="1"
                                           max="30">
                                    <span asp-validation-for="Days" class="text-danger"></span>
                                    <div class="form-text">Để trống nếu muốn gợi ý dựa trên ngân sách</div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label for="NumberOfPeople" class="form-label fw-bold">
                                        <i class="fas fa-users text-warning me-2"></i>Số người đi
                                    </label>
                                    <input type="number"
                                           class="form-control form-control-lg"
                                           id="NumberOfPeople"
                                           name="NumberOfPeople"
                                           placeholder="Nhập số người"
                                           value="@(Model?.NumberOfPeople > 0 ? Model.NumberOfPeople : 1)"
                                           min="1"
                                           max="50"
                                           required>
                                    <span asp-validation-for="NumberOfPeople" class="text-danger"></span>
                                    <div class="form-text">Số người tham gia chuyến đi</div>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-4">
                                    <label class="form-label fw-bold">
                                        <i class="fas fa-car text-danger me-2"></i>Phương tiện di chuyển
                                    </label>
                                    <select class="form-select form-select-lg" id="TransportType" name="TransportType">
                                        <option value="Kết hợp tự động" selected>Kết hợp tự động</option>
                                        <option value="Xe riêng">Xe riêng</option>
                                        <option value="Xe bus">Xe bus</option>
                                        <option value="Taxi">Taxi</option>
                                        <option value="Xe máy">Xe máy</option>
                                    </select>
                                    <span asp-validation-for="TransportType" class="text-danger"></span>
                                    <div class="form-text">Hệ thống sẽ tự động đề xuất đi bộ cho chặng dưới 2km</div>
                                </div>

                                <div class="col-md-6 mb-4">
                                    <label asp-for="IsVegetarian" class="form-label fw-bold">
                                        <i class="fas fa-leaf text-success me-2"></i>Chế độ ăn
                                    </label>
                                    <select asp-for="IsVegetarian" class="form-select form-select-lg">
                                        <option value="False" selected>Ăn Mặn (Mặc định)</option>
                                        <option value="True">Ăn Chay</option>
                                    </select>
                                    <span asp-validation-for="IsVegetarian" class="text-danger"></span>
                                    <div class="form-text">Chọn chế độ ăn để lọc nhà hàng</div>
                                </div>
                            </div>

                            <div class="row mb-4" id="budgetPreview" style="display: none;">
                                <div class="col-12">
                                    <div class="card bg-light">
                                        <div class="card-body">
                                            <h6 class="card-title">
                                                <i class="fas fa-calculator me-2"></i>Phân bổ ngân sách dự kiến
                                            </h6>
                                            <div class="row text-center">
                                                <div class="col-3">
                                                    <div class="border-end">
                                                        <div class="text-primary fw-bold" id="accommodationBudget">0 VNĐ</div>
                                                        <small class="text-muted">Lưu trú (30%)</small>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="border-end">
                                                        <div class="text-success fw-bold" id="transportBudget">0 VNĐ</div>
                                                        <small class="text-muted">Di chuyển (20%)</small>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="border-end">
                                                        <div class="text-warning fw-bold" id="foodBudget">0 VNĐ</div>
                                                        <small class="text-muted">Ẩm thực (25%)</small>
                                                    </div>
                                                </div>
                                                <div class="col-3">
                                                    <div class="text-info fw-bold" id="activityBudget">0 VNĐ</div>
                                                    <small class="text-muted">Hoạt động (15%)</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="text-center">
                                <button type="submit" class="btn btn-primary btn-lg px-5 py-3" id="submitBtn">
                                    <i class="fas fa-magic me-2"></i>Tạo kế hoạch du lịch
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mt-5">
            <div class="col-12">
                <h3 class="text-center mb-5">Tại sao chọn Trip Planner?</h3>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="bg-primary bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-brain text-white fa-2x"></i>
                        </div>
                        <h5 class="card-title">Planer Thông Minh</h5>
                        <p class="card-text text-muted">Sử dụng trí tuệ nhân tạo để tạo lịch trình tối ưu dựa trên ngân sách và sở thích của bạn.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="bg-success bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-clock text-white fa-2x"></i>
                        </div>
                        <h5 class="card-title">Tiết Kiệm Thời Gian</h5>
                        <p class="card-text text-muted">Chỉ trong vài giây, bạn sẽ có một kế hoạch du lịch hoàn chỉnh và chi tiết.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body text-center p-4">
                        <div class="bg-warning bg-gradient rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px;">
                            <i class="fas fa-dollar-sign text-white fa-2x"></i>
                        </div>
                        <h5 class="card-title">Tính Toán Chi Phí</h5>
                        <p class="card-text text-muted">Phân bổ ngân sách hợp lý cho từng hạng mục: lưu trú, di chuyển, ẩm thực, hoạt động.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .hero-section {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        position: relative;
        overflow: hidden;
    }

        .hero-section::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 100" fill="white" opacity="0.1"><polygon points="0,0 1000,100 1000,0"/></svg>');
            background-size: cover;
        }

    .card {
        border-radius: 20px;
        transition: all 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1) !important;
        }

    .form-control, .form-select {
        border-radius: 12px;
        border: 2px solid #e9ecef;
        transition: all 0.3s ease;
    }

        .form-control:focus, .form-select:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

    .btn {
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.2);
        }

    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    .bg-gradient {
        background: linear-gradient(45deg, #667eea, #764ba2);
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const budgetInput = document.getElementById('Budget');
        const budgetPreview = document.getElementById('budgetPreview');
        const accommodationBudget = document.getElementById('accommodationBudget');
        const transportBudget = document.getElementById('transportBudget');
        const foodBudget = document.getElementById('foodBudget');
        const activityBudget = document.getElementById('activityBudget');

        function formatCurrency(amount) {
            return new Intl.NumberFormat('vi-VN').format(amount) + ' VNĐ';
        }

        function updateBudgetPreview() {
            const budget = parseFloat(budgetInput.value) || 0;
            if (budget > 0) {
                // Phân bổ ngân sách dựa trên tỉ lệ giả định (30%, 20%, 25%, 15%)
                accommodationBudget.textContent = formatCurrency(budget * 0.3);
                transportBudget.textContent = formatCurrency(budget * 0.2);
                foodBudget.textContent = formatCurrency(budget * 0.25);
                activityBudget.textContent = formatCurrency(budget * 0.15);
                budgetPreview.style.display = 'block';
            } else {
                budgetPreview.style.display = 'none';
            }
        }

        // Khởi chạy lần đầu và lắng nghe sự kiện
        updateBudgetPreview();
        budgetInput.addEventListener('input', updateBudgetPreview);

        // Form submission and validation logic
        const form = document.getElementById('tripForm');
        form.addEventListener('submit', function(e) {
            const destination = document.getElementById('Destination').value.trim();
            const budget = parseFloat(document.getElementById('Budget').value);
            const numberOfPeople = parseInt(document.getElementById('NumberOfPeople').value);

            if (!destination) {
                e.preventDefault();
                alert('Vui lòng nhập địa điểm du lịch!');
                return;
            }

            if (!budget || budget < 1000000) {
                e.preventDefault();
                alert('Ngân sách phải tối thiểu 1,000,000 VNĐ!');
                return;
            }

            if (!numberOfPeople || numberOfPeople < 1) {
                e.preventDefault();
                alert('Vui lòng nhập số người đi!');
                return;
            }

            // Show loading state
            const submitBtn = document.getElementById('submitBtn');
            submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Đang tạo kế hoạch...';
            submitBtn.disabled = true;
        });
    });
</script>