@model List<TravelWeb.Models.Destination>

@{
    ViewData["Title"] = "Kiểm tra Địa điểm và Tọa độ";
}

<div class="container my-5">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-lg border-0 mb-4">
                <div class="card-header bg-gradient text-white py-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h2 class="mb-0">
                        <i class="fas fa-map-marked-alt me-3"></i>Kiểm tra Địa điểm và Tọa độ
                    </h2>
                    <p class="mb-0 mt-2">Danh sách tất cả các địa điểm có sẵn trong hệ thống với tọa độ và điểm tham quan</p>
                </div>
                <div class="card-body p-4">
                    <!-- Statistics -->
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <div class="stat-box text-center p-3 bg-primary text-white rounded">
                                <h3 class="mb-0">@Model.Count</h3>
                                <p class="mb-0">Địa điểm</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box text-center p-3 bg-success text-white rounded">
                                <h3 class="mb-0">@Model.Sum(d => d.Attractions.Count)</h3>
                                <p class="mb-0">Điểm tham quan</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="stat-box text-center p-3 bg-info text-white rounded">
                                <h3 class="mb-0">@Model.Count(d => d.Attractions.Count > 0)</h3>
                                <p class="mb-0">Địa điểm có tọa độ</p>
                            </div>
                        </div>
                    </div>

                    <!-- Destination List -->
                    @foreach (var dest in Model)
                    {
                        <div class="destination-card mb-4">
                            <div class="card border-0 shadow-sm">
                                <div class="card-header bg-light">
                                    <div class="row align-items-center">
                                        <div class="col-md-8">
                                            <h4 class="mb-1">
                                                <i class="fas fa-map-pin text-danger me-2"></i>@dest.Name
                                            </h4>
                                            <p class="text-muted mb-0">@dest.Description</p>
                                            <small class="text-muted">
                                                <i class="fas fa-location-dot me-1"></i>
                                                Tọa độ: @dest.Latitude.ToString("F4"), @dest.Longitude.ToString("F4")
                                            </small>
                                        </div>
                                        <div class="col-md-4 text-end">
                                            <span class="badge bg-primary fs-6">
                                                @dest.Attractions.Count điểm tham quan
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-body">
                                    @if (dest.Attractions.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-hover">
                                                <thead class="table-light">
                                                    <tr>
                                                        <th>STT</th>
                                                        <th>Tên điểm</th>
                                                        <th>Mô tả</th>
                                                        <th>Loại</th>
                                                        <th>Tọa độ</th>
                                                        <th>Thời gian</th>
                                                        <th>Phí vào cửa</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (int i = 0; i < dest.Attractions.Count; i++)
                                                    {
                                                        var attr = dest.Attractions[i];
                                                        <tr>
                                                            <td>@(i + 1)</td>
                                                            <td>
                                                                <strong>@attr.Name</strong>
                                                            </td>
                                                            <td>@attr.Description</td>
                                                            <td>
                                                                <span class="badge bg-info">@attr.Type</span>
                                                            </td>
                                                            <td>
                                                                <small class="text-muted">
                                                                    @attr.Latitude.ToString("F4")<br/>
                                                                    @attr.Longitude.ToString("F4")
                                                                </small>
                                                            </td>
                                                            <td>@attr.VisitDuration phút</td>
                                                            <td>@attr.EntranceFee.ToString("N0") đ</td>
                                                        </tr>

                                                        @* Hiển thị khoảng cách đến điểm tiếp theo *@
                                                        @if (i < dest.Attractions.Count - 1)
                                                        {
                                                            var next = dest.Attractions[i + 1];
                                                            var distance = TravelWeb.Models.DestinationData.CalculateDistance(
                                                                attr.Latitude, attr.Longitude,
                                                                next.Latitude, next.Longitude
                                                            );
                                                            <tr class="table-secondary">
                                                                <td colspan="7" class="text-center">
                                                                    <i class="fas fa-arrow-down me-2"></i>
                                                                    Khoảng cách đến <strong>@next.Name</strong>: 
                                                                    <span class="badge bg-success">@distance.ToString("F1") km</span>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }

                                                    @* Khoảng cách quay về điểm đầu *@
                                                    @if (dest.Attractions.Count > 1)
                                                    {
                                                        var last = dest.Attractions[dest.Attractions.Count - 1];
                                                        var first = dest.Attractions[0];
                                                        var returnDistance = TravelWeb.Models.DestinationData.CalculateDistance(
                                                            last.Latitude, last.Longitude,
                                                            first.Latitude, first.Longitude
                                                        );
                                                        <tr class="table-warning">
                                                            <td colspan="7" class="text-center">
                                                                <i class="fas fa-undo me-2"></i>
                                                                Khoảng cách quay về <strong>@first.Name</strong>: 
                                                                <span class="badge bg-primary">@returnDistance.ToString("F1") km</span>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>

                                        <!-- Tổng kết -->
                                        <div class="alert alert-info mt-3">
                                            @{
                                                double totalDistance = 0;
                                                for (int i = 0; i < dest.Attractions.Count - 1; i++)
                                                {
                                                    var from = dest.Attractions[i];
                                                    var to = dest.Attractions[i + 1];
                                                    totalDistance += TravelWeb.Models.DestinationData.CalculateDistance(
                                                        from.Latitude, from.Longitude, to.Latitude, to.Longitude
                                                    );
                                                }
                                                // Thêm quãng đường quay về
                                                if (dest.Attractions.Count > 1)
                                                {
                                                    var last = dest.Attractions[dest.Attractions.Count - 1];
                                                    var first = dest.Attractions[0];
                                                    totalDistance += TravelWeb.Models.DestinationData.CalculateDistance(
                                                        last.Latitude, last.Longitude, first.Latitude, first.Longitude
                                                    );
                                                }

                                                int totalTime = dest.Attractions.Sum(a => a.VisitDuration);
                                                decimal totalFee = dest.Attractions.Sum(a => a.EntranceFee);
                                            }
                                            <strong><i class="fas fa-info-circle me-2"></i>Tổng kết hành trình:</strong>
                                            <ul class="mb-0 mt-2">
                                                <li>Tổng quãng đường: <strong>@totalDistance.ToString("F1") km</strong></li>
                                                <li>Tổng thời gian tham quan: <strong>@(totalTime / 60) giờ @(totalTime % 60) phút</strong></li>
                                                <li>Tổng phí vào cửa: <strong>@totalFee.ToString("N0") đ</strong></li>
                                            </ul>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning">
                                            <i class="fas fa-exclamation-triangle me-2"></i>
                                            Địa điểm này chưa có điểm tham quan với tọa độ
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Hướng dẫn thêm địa điểm mới -->
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-plus-circle me-2"></i>Hướng dẫn thêm địa điểm mới
                    </h5>
                </div>
                <div class="card-body">
                    <p>Để thêm địa điểm mới vào hệ thống, bạn cần:</p>
                    <ol>
                        <li>Mở file <code>Models/DestinationData.cs</code></li>
                        <li>Thêm <code>Destination</code> mới vào list <code>Destinations</code></li>
                        <li>Cung cấp tọa độ (Latitude, Longitude) cho địa điểm chính</li>
                        <li>Thêm các <code>AttractionPoint</code> với tọa độ chi tiết</li>
                    </ol>
                    <div class="alert alert-info">
                        <strong>💡 Mẹo:</strong> Bạn có thể lấy tọa độ từ Google Maps bằng cách:
                        <ul class="mb-0">
                            <li>Mở Google Maps</li>
                            <li>Click chuột phải vào địa điểm</li>
                            <li>Chọn tọa độ đầu tiên trong menu (sẽ tự động copy)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .stat-box {
        transition: all 0.3s ease;
    }
    
    .stat-box:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15);
    }
    
    .destination-card {
        transition: all 0.3s ease;
    }
    
    .destination-card:hover {
        transform: translateX(5px);
    }
    
    .card {
        border-radius: 15px;
    }
    
    .table {
        font-size: 0.9rem;
    }
    
    .badge {
        padding: 0.5rem 1rem;
    }
</style>