@section Scripts {
    <script>
        (function(){
            const cards = document.querySelectorAll(".transport-card");
            const selProvider = document.getElementById("filterProvider");
            const selMode = document.getElementById("filterMode");
            const minPrice = document.getElementById("minPrice");
            const maxPrice = document.getElementById("maxPrice");
            const btnClear = document.getElementById("btnClearFilters");
            const sortOptions = document.getElementById("sortOptions");
            const visibleCount = document.getElementById("visibleCount");

            function normalize(v){ return (v||"").toString().toLowerCase(); }
            function toNum(v){ const n = Number(v); return isNaN(n)?null:n; }

            function applyFilters(){
                const p = normalize(selProvider?.value || "");
                const m = normalize(selMode?.value || "");
                const min = toNum(minPrice?.value);
                const max = toNum(maxPrice?.value);

                let visible = 0;
                cards.forEach(card => {
                    const rp = normalize(card.dataset.provider);
                    const rm = normalize(card.dataset.mode);
                    const price = Number(card.dataset.price) || 0;

                    let ok = true;
                    if (p && rp !== p) ok = false;
                    if (m && rm !== m) ok = false;
                    if (min !== null && price < min) ok = false;
                    if (max !== null && price > max) ok = false;

                    card.style.display = ok ? "" : "none";
                    if (ok) visible++;
                });

                if (visibleCount) visibleCount.textContent = visible;
            }

            function applySort(){
                const sortValue = sortOptions?.value || "price-asc";
                const container = document.getElementById("transportCards");
                const cardArray = Array.from(container.querySelectorAll(".transport-card"));
                
                cardArray.sort((a, b) => {
                    switch(sortValue) {
                        case "price-asc":
                            return (Number(a.dataset.price) || 0) - (Number(b.dataset.price) || 0);
                        case "price-desc":
                            return (Number(b.dataset.price) || 0) - (Number(a.dataset.price) || 0);
                        case "duration-asc":
                            const durA = a.dataset.duration || "";
                            const durB = b.dataset.duration || "";
                            return durA.localeCompare(durB);
                        case "provider-asc":
                            return (a.dataset.provider || "").localeCompare(b.dataset.provider || "");
                        default:
                            return 0;
                    }
                });

                cardArray.forEach(card => container.appendChild(card));
            }

            [selProvider, selMode, minPrice, maxPrice].forEach(el =>
                el && el.addEventListener("input", applyFilters)
            );

            sortOptions?.addEventListener("change", applySort);

            btnClear?.addEventListener("click", () => {
                if (selProvider) selProvider.value = "";
                if (selMode) selMode.value = "";
                if (minPrice) minPrice.value = minPrice.getAttribute("value") || "";
                if (maxPrice) maxPrice.value = maxPrice.getAttribute("value") || "";
                applyFilters();
            });

            // Initialize
            applyFilters();
        })();
    </script>

    <style>
        .transport-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }

        .transport-card-item {
            border-radius: 15px;
            overflow: hidden;
            transition: all 0.3s ease;
        }

        .transport-card-item:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
        }

        .transport-card-item .card-header .badge {
            font-weight: 500;
        }

        .transport-card-item .btn-success {
            background: linear-gradient(135deg, #22b573 0%, #1a9a63 100%);
            border: none;
            font-weight: 500;
        }

        .transport-card-item .btn-success:hover {
            background: linear-gradient(135deg, #1a9a63 0%, #158a55 100%);
            transform: translateY(-1px);
        }

        .alert-info {
            background-color: #e7f3ff;
            border-color: #b3d9ff;
            color: #004085;
        }
    </style>
}
