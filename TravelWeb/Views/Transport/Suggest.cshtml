@model IEnumerable<TravelWeb.Models.TripWithId>

<div class="container mt-4">

    <div class="p-4 text-white rounded" style="background: linear-gradient(90deg, #003c71, #005fa3);">
        <h2 class="fw-bold"><span>🚐 Danh sách phương tiện di chuyển</span></h2>
        <p>So sánh – chọn phương tiện phù hợp – đặt vé nhanh chóng!</p>
    </div>

    <div class="mt-4">

        @if (!Model.Any())
        {
            <div class="text-center p-5 bg-light rounded shadow-sm">
                <i class="fa fa-calendar fs-1 text-primary"></i>
                <p class="mt-3">Hiện chưa có phương tiện nào.</p>
            </div>
        }
        else
        {
            foreach (var trip in Model)
            {
                <div class="card shadow-sm p-3 mb-3">

                    <h4 class="fw-bold text-primary">@trip.ToProvince</h4>

                    <p>🚗 Phương tiện: <b>@trip.TransportType</b></p>
                    <p>📍 Khởi hành từ: <b>@trip.FromCity</b></p>
                    <p>📅 Ngày đi: <b>@trip.DepartureDate.ToString("dd/MM/yyyy")</b></p>

                    <div class="text-danger fw-bold fs-5">
                        @trip.Price.ToString("N0") VNĐ
                    </div>

                    <a href="/Transport/Detail/@trip.Id"
                       class="btn btn-success mt-2">
                        Xem chi tiết & Đặt vé
                    </a>
                </div>
            }
        }
    </div>

</div>
