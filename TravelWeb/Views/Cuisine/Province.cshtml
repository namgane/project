@using TravelWeb.Models
@model CuisineProvinceViewModel

@{
    ViewData["Title"] = $"Ẩm thực {Model.Province}";
}

<style>
    :root {
        --gold: #e7c27d;
        --brown: #5d3d1a;
        --green: #2f6f55;
        --bg: #faf5ee;
    }

    body {
        background: var(--bg);
    }

    /* HERO */
    .hero {
        height: 420px;
        background: linear-gradient( rgba(0,0,0,.55), rgba(0,0,0,.7) ), url('https://source.unsplash.com/1600x900/?vietnam,food,@Model.Province') center / cover no-repeat;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        text-align: center;
        border-radius: 0 0 40px 40px;
        margin-bottom: 60px;
    }

        .hero h1 {
            font-size: 52px;
            font-weight: 900;
            text-shadow: 0 4px 12px rgba(0,0,0,.5);
        }

        .hero p {
            font-size: 18px;
            opacity: .9;
        }

    /* STATS */
    .stat-box {
        background: #fff;
        border-radius: 20px;
        padding: 25px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0,0,0,.1);
    }

        .stat-box h3 {
            color: var(--brown);
            font-weight: 800;
            margin-bottom: 5px;
        }

        .stat-box span {
            color: #777;
        }

    /* CARD */
    .food-card {
        background: #fff;
        border-radius: 22px;
        overflow: hidden;
        transition: .4s;
        box-shadow: 0 6px 20px rgba(0,0,0,.12);
        height: 100%;
    }

        .food-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 45px rgba(0,0,0,.25);
        }

    .food-img {
        height: 200px;
        background-size: cover;
        background-position: center;
    }

    .food-body {
        padding: 20px;
    }

    .food-title {
        font-size: 20px;
        font-weight: 800;
        color: var(--brown);
    }

    .food-desc {
        font-size: 14px;
        color: #666;
        margin: 10px 0;
        min-height: 42px;
    }

    .badge-region {
        background: var(--green);
        color: #fff;
        border-radius: 20px;
        padding: 4px 12px;
        font-size: 12px;
        font-weight: 600;
    }
</style>

<form method="get" class="row g-3 mb-5">

    <input type="hidden" name="name" value="@Model.Province" />

    <div class="col-md-3">
        <input name="minPrice"
               class="form-control"
               placeholder="Giá từ" />
    </div>

    <div class="col-md-3">
        <input name="maxPrice"
               class="form-control"
               placeholder="Giá đến" />
    </div>

    <div class="col-md-3">
        <input name="minPopularity"
               class="form-control"
               placeholder="Độ phổ biến ≥" />
    </div>

    <div class="col-md-3 d-grid">
        <button class="btn btn-dark">Lọc</button>
    </div>

</form>


<!-- HERO -->
<section class="hero">
    <div>
        <h1>@Model.Province</h1>
        <p>Đặc sản & tinh hoa ẩm thực vùng miền</p>
    </div>
</section>

<div class="container">

    <!-- STATS -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="stat-box">
                <h3>@Model.Items.Count</h3>
                <span>Món đặc trưng</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-box">
                <h3>@Model.OverallAveragePrice.ToString("N0") đ</h3>
                <span>Giá trung bình</span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="stat-box">
                <h3>@Model.Items.Sum(x => x.Popularity)</h3>
                <span>Mức độ phổ biến</span>
            </div>
        </div>
    </div>

    <!-- FOOD LIST -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

        @foreach (var food in Model.Items)
        {
            <div class="food-card">

                <!-- THÔNG TIN MÓN -->
                <h3>@food.Name</h3>
                <p>@food.Description</p>

                <div class="price-pop">
                    <span>💰 @food.AveragePrice.ToString("N0") đ</span>
                    <span>🔥 @food.Popularity</span>
                </div>

                <!-- ⭐ RATING -->
                <div class="rating">
                    @{
                        var avg = Model.AverageRatings[food.Name];
                        var count = Model.RatingsCount[food.Name];
                    }

                    @for (int i = 1; i <= 5; i++)
                    {
                        <i class="bi @(i <= Math.Round(avg) ? "bi-star-fill text-warning" : "bi-star")"></i>
                    }
                    <span class="text-muted">(@count đánh giá)</span>
                </div>

                <!-- 📝 FORM NHẬN XÉT -->
                <form asp-controller="Cuisine"
                       asp-action="AddReview"
                       method="post">

                    <input type="hidden" name="province" value="@Model.Province" />
                    <input type="hidden" name="foodName" value="@Model.Items" />

                    <input name="displayName" class="form-control" placeholder="Tên của bạn" />

                    <select name="rating" class="form-select">
                        <option value="5">★★★★★</option>
                        <option value="4">★★★★☆</option>
                        <option value="3">★★★☆☆</option>
                        <option value="2">★★☆☆☆</option>
                        <option value="1">★☆☆☆☆</option>
                    </select>

                    <textarea name="comment" class="form-control"
                          placeholder="Nhận xét..."></textarea>

                    <button type="submit" class="btn btn-success">Gửi</button>
                </form>


                <!-- 💬 DANH SÁCH NHẬN XÉT -->
                <div class="reviews">
                    @foreach (var r in Model.Reviews[food.Name].Take(3))
                    {
                        <div class="review-item">
                            <strong>@r.UserName</strong>
                            <span>
                                @for (int i = 1; i <= r.Rating; i++)
                                {
                                    <i class="bi bi-star-fill text-warning"></i>
                                }
                            </span>
                            <p>@r.Comment</p>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
    .rating {
    margin-top: 6px;
    font-size: 14px;
    }

    .review-form textarea {
    resize: none;
    font-size: 13px;
    }

    .review-item {
    background: #f8f9fa;
    padding: 6px 8px;
    border-radius: 6px;
    margin-top: 5px;
    font-size: 13px;
    }

    <!-- BACK -->
    <div class="text-center mt-5">
        <a asp-action="Index" class="btn btn-outline-dark btn-lg px-5">
            ← Quay lại danh sách tỉnh
        </a>
    </div>

</div>
