@model TravelWeb.Models.CuisineProvinceViewModel
@{
    ViewData["Title"] = $"Ẩm thực {Model.Province}";
    var minPrice = Model.Items.Any() ? Model.Items.Min(x => x.AveragePrice) : 0;
    var maxPrice = Model.Items.Any() ? Model.Items.Max(x => x.AveragePrice) : 0;
}

<!-- HERO SECTION -->
<section class="cuisine-province-hero py-5 mb-4 text-white">
    <div class="hero-bg-overlay"></div>
    <div class="container position-relative">
        <nav aria-label="breadcrumb" class="mb-3">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-white-50">Trang chủ</a></li>
                <li class="breadcrumb-item"><a asp-controller="Cuisine" asp-action="Index" class="text-white-50">Ẩm thực</a></li>
                <li class="breadcrumb-item active text-white" aria-current="page">@Model.Province</li>
            </ol>
        </nav>
        <div class="text-center">
            <h1 class="display-4 fw-bold mb-2">
                <i class="bi bi-egg-fried"></i> Ẩm thực @Model.Province
            </h1>
            <p class="lead mb-4">Khám phá @Model.Items.Count món đặc trưng và giá trung bình tại địa phương</p>
            <div class="d-flex flex-wrap gap-3 justify-content-center">
                <a asp-controller="TripPlanner" asp-action="Index" asp-route-destination="@Model.Province" class="btn btn-light btn-lg">
                    <i class="bi bi-calendar-event"></i> Lập kế hoạch
                </a>
                <a asp-controller="Festival" asp-action="Index" asp-route-province="@Model.Province" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-calendar3"></i> Lễ hội
                </a>
                <a asp-controller="Transport" asp-action="Suggest" asp-route-to="@Model.Province" class="btn btn-outline-light btn-lg">
                    <i class="bi bi-bus-front"></i> Di chuyển
                </a>
            </div>
        </div>
    </div>
</section>

<!-- STATISTICS SUMMARY -->
<div class="container mb-4">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-4">
                <i class="bi bi-graph-up text-primary"></i> Thống kê chi phí
            </h5>
            <div class="row g-3 text-center">
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-value text-primary">@Model.OverallAveragePrice.ToString("N0")</div>
                        <div class="stat-label">VNĐ</div>
                        <small class="text-muted">Trung bình</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-value text-success">@minPrice.ToString("N0")</div>
                        <div class="stat-label">VNĐ</div>
                        <small class="text-muted">Thấp nhất</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-value text-danger">@maxPrice.ToString("N0")</div>
                        <div class="stat-label">VNĐ</div>
                        <small class="text-muted">Cao nhất</small>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-value text-info">@Model.Items.Count</div>
                        <div class="stat-label">Món</div>
                        <small class="text-muted">Tổng số</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FILTER & SORT -->
<div class="container mb-4">
    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-funnel"></i> Lọc theo giá
                    </label>
                    <div class="input-group">
                        <input type="number" id="filterMinPrice" class="form-control" placeholder="Từ" min="0" value="@((int)minPrice)" />
                        <span class="input-group-text">-</span>
                        <input type="number" id="filterMaxPrice" class="form-control" placeholder="Đến" min="0" value="@((int)maxPrice)" />
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-sort-down"></i> Sắp xếp
                    </label>
                    <select id="sortOptions" class="form-select">
                        <option value="popularity-desc">Phổ biến nhất</option>
                        <option value="price-asc">Giá tăng dần</option>
                        <option value="price-desc">Giá giảm dần</option>
                        <option value="name-asc">Tên A-Z</option>
                        <option value="rating-desc">Đánh giá cao</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search"></i> Tìm kiếm
                    </label>
                    <input type="text" id="searchInput" class="form-control" placeholder="Tên món..." />
                </div>
                <div class="col-md-2 d-grid">
                    <button id="btnClearFilters" class="btn btn-outline-secondary">
                        <i class="bi bi-x-circle"></i> Xóa lọc
                    </button>
                </div>
            </div>
            <div class="mt-3">
                <span class="text-muted">Hiển thị <strong id="visibleCount">@Model.Items.Count</strong> / @Model.Items.Count món</span>
            </div>
        </div>
    </div>
</div>

<!-- CUISINE GRID -->
<div class="container mb-5">
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="cuisineGrid">
        @foreach (var item in Model.Items)
        {
            var avg = Model.AverageRatings.ContainsKey(item.Name) ? Model.AverageRatings[item.Name] : 0;
            var cnt = Model.RatingsCount.ContainsKey(item.Name) ? Model.RatingsCount[item.Name] : 0;
            
            <div class="col cuisine-item-card" 
                 data-price="@item.AveragePrice" 
                 data-popularity="@item.Popularity"
                 data-name="@item.Name.ToLower()"
                 data-rating="@avg">
                <div class="card h-100 shadow-sm border-0 rounded-4 cuisine-card">
                    <div class="position-relative overflow-hidden">
                        <img src="@item.ImageUrl"
                             class="card-img-top cuisine-image"
                             alt="@item.Name"
                             loading="lazy"
                             onerror="this.src='/images/default-food.jpg'" />
                        <div class="price-badge">
                            <span class="badge bg-success fs-6 px-3 py-2">
                                <i class="bi bi-cash-coin"></i> @item.AveragePrice.ToString("N0") đ
                            </span>
                        </div>
                        @if (item.Popularity >= 95)
                        {
                            <div class="popular-badge">
                                <span class="badge bg-danger">
                                    <i class="bi bi-fire"></i> Hot
                                </span>
                            </div>
                        }
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold mb-2">@item.Name</h5>
                        
                        <!-- Rating -->
                        <div class="mb-2">
                            <div class="d-flex align-items-center">
                                <div class="rating-stars me-2">
                                    @for (int s = 1; s <= 5; s++)
                                    {
                                        if (avg >= s)
                                        {
                                            <i class="bi bi-star-fill text-warning"></i>
                                        }
                                        else if (avg >= s - 0.5)
                                        {
                                            <i class="bi bi-star-half text-warning"></i>
                                        }
                                        else
                                        {
                                            <i class="bi bi-star text-warning"></i>
                                        }
                                    }
                                </div>
                                @if (avg > 0)
                                {
                                    <span class="text-muted small">@avg.ToString("F1") (@cnt)</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có đánh giá</span>
                                }
                            </div>
                        </div>
                        
                        <p class="text-muted small mb-3 flex-grow-1">@item.Description</p>
                        
                        <div class="d-flex flex-wrap gap-2 mb-3">
                            <span class="badge bg-primary">
                                <i class="bi bi-geo-alt"></i> @Model.Province
                            </span>
                            <span class="badge bg-info">
                                <i class="bi bi-star"></i> Độ phổ biến: @item.Popularity
                            </span>
                        </div>
                        
                        <!-- Actions -->
                        <div class="d-grid gap-2">
                            <a asp-action="Details" 
                               asp-route-province="@Model.Province" 
                               asp-route-name="@item.Name" 
                               class="btn btn-primary">
                                <i class="bi bi-info-circle"></i> Chi tiết
                            </a>
                            <div class="d-flex gap-2">
                                <form method="post" asp-controller="Favorites" asp-action="Add" class="flex-grow-1">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@($"cuisine:{Model.Province}:{item.Name}")" />
                                    <input type="hidden" name="Type" value="cuisine" />
                                    <input type="hidden" name="Title" value="@item.Name" />
                                    <input type="hidden" name="Subtitle" value="@Model.Province - @item.AveragePrice.ToString("N0") đ" />
                                    <input type="hidden" name="Url" value="@Url.Action("Details", "Cuisine", new { province = Model.Province, name = item.Name })" />
                                    <input type="hidden" name="ImageUrl" value="@item.ImageUrl" />
                                    <button class="btn btn-outline-primary w-100" type="submit">
                                        <i class="bi bi-bookmark-plus"></i> Lưu
                                    </button>
                                </form>
                                
                                <button class="btn btn-outline-success"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#review_@item.Name.Replace(" ", "_").Replace(".", "_")"
                                        aria-expanded="false">
                                    <i class="bi bi-chat-dots"></i>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Review Form -->
                        <div class="collapse mt-3" id="review_@item.Name.Replace(" ", "_").Replace(".", "_")">
                            <div class="card border shadow-sm">
                                <div class="card-body p-3">
                                    <h6 class="fw-bold mb-3">
                                        <i class="bi bi-star-fill text-warning"></i> Đánh giá món ăn
                                    </h6>
                                    <form method="post" asp-controller="Reviews" asp-action="Add">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="cuisineId" value="@($"cuisine:{Model.Province}:{item.Name}")" />
                                        <input type="hidden" name="returnProvince" value="@Model.Province" />
                                        <input type="hidden" name="returnTo" value="Province" />
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Tên của bạn *</label>
                                            <input name="displayName" class="form-control form-control-sm" placeholder="Nhập tên của bạn" required />
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Đánh giá *</label>
                                            <div class="star-rating-input-small">
                                                <input type="radio" name="rating" value="5" id="star5_@item.Name.Replace(" ", "_").Replace(".", "_")" required />
                                                <label for="star5_@item.Name.Replace(" ", "_").Replace(".", "_")" class="star-label-small"><i class="bi bi-star-fill"></i></label>
                                                <input type="radio" name="rating" value="4" id="star4_@item.Name.Replace(" ", "_").Replace(".", "_")" />
                                                <label for="star4_@item.Name.Replace(" ", "_").Replace(".", "_")" class="star-label-small"><i class="bi bi-star-fill"></i></label>
                                                <input type="radio" name="rating" value="3" id="star3_@item.Name.Replace(" ", "_").Replace(".", "_")" />
                                                <label for="star3_@item.Name.Replace(" ", "_").Replace(".", "_")" class="star-label-small"><i class="bi bi-star-fill"></i></label>
                                                <input type="radio" name="rating" value="2" id="star2_@item.Name.Replace(" ", "_").Replace(".", "_")" />
                                                <label for="star2_@item.Name.Replace(" ", "_").Replace(".", "_")" class="star-label-small"><i class="bi bi-star-fill"></i></label>
                                                <input type="radio" name="rating" value="1" id="star1_@item.Name.Replace(" ", "_").Replace(".", "_")" />
                                                <label for="star1_@item.Name.Replace(" ", "_").Replace(".", "_")" class="star-label-small"><i class="bi bi-star-fill"></i></label>
                                            </div>
                                        </div>
                                        
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold">Nhận xét (tùy chọn)</label>
                                            <textarea name="comment" class="form-control form-control-sm" rows="3" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                                        </div>
                                        
                                        <div class="d-grid gap-2">
                                            <button class="btn btn-primary btn-sm" type="submit">
                                                <i class="bi bi-send"></i> Gửi đánh giá
                                            </button>
                                            <a asp-action="Details" asp-route-province="@Model.Province" asp-route-name="@item.Name" class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-right"></i> Xem tất cả đánh giá
                                            </a>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- EMPTY STATE -->
<div id="emptyState" class="container d-none">
    <div class="card border-0 shadow-sm mx-auto" style="max-width: 600px;">
        <div class="card-body text-center py-5">
            <div class="display-1 mb-3">🔍</div>
            <h4 class="fw-bold mb-2">Không tìm thấy món ăn nào</h4>
            <p class="text-muted">Thử điều chỉnh bộ lọc để xem thêm kết quả.</p>
            <button id="btnResetFilters" class="btn btn-primary">
                <i class="bi bi-arrow-counterclockwise"></i> Xóa tất cả bộ lọc
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            const cards = document.querySelectorAll('.cuisine-item-card');
            const filterMinPrice = document.getElementById('filterMinPrice');
            const filterMaxPrice = document.getElementById('filterMaxPrice');
            const sortOptions = document.getElementById('sortOptions');
            const searchInput = document.getElementById('searchInput');
            const btnClearFilters = document.getElementById('btnClearFilters');
            const btnResetFilters = document.getElementById('btnResetFilters');
            const visibleCount = document.getElementById('visibleCount');
            const emptyState = document.getElementById('emptyState');
            const cuisineGrid = document.getElementById('cuisineGrid');
            
            function applyFilters() {
                const minPrice = parseFloat(filterMinPrice?.value) || 0;
                const maxPrice = parseFloat(filterMaxPrice?.value) || Infinity;
                const searchTerm = (searchInput?.value || '').toLowerCase().trim();
                
                let visible = 0;
                
                cards.forEach(card => {
                    const price = parseFloat(card.dataset.price) || 0;
                    const name = card.dataset.name || '';
                    
                    let show = true;
                    
                    if (price < minPrice || price > maxPrice) show = false;
                    if (searchTerm && !name.includes(searchTerm)) show = false;
                    
                    card.style.display = show ? '' : 'none';
                    if (show) visible++;
                });
                
                if (visibleCount) visibleCount.textContent = visible;
                
                // Show/hide empty state
                if (visible === 0) {
                    emptyState?.classList.remove('d-none');
                    cuisineGrid?.classList.add('d-none');
                } else {
                    emptyState?.classList.add('d-none');
                    cuisineGrid?.classList.remove('d-none');
                }
            }
            
            function applySort() {
                const sortValue = sortOptions?.value || 'popularity-desc';
                const container = cuisineGrid;
                if (!container) return;
                
                const cardArray = Array.from(container.querySelectorAll('.cuisine-item-card'));
                const visibleCards = cardArray.filter(c => c.style.display !== 'none');
                
                visibleCards.sort((a, b) => {
                    switch(sortValue) {
                        case 'popularity-desc':
                            return (parseInt(b.dataset.popularity) || 0) - (parseInt(a.dataset.popularity) || 0);
                        case 'price-asc':
                            return (parseFloat(a.dataset.price) || 0) - (parseFloat(b.dataset.price) || 0);
                        case 'price-desc':
                            return (parseFloat(b.dataset.price) || 0) - (parseFloat(a.dataset.price) || 0);
                        case 'name-asc':
                            return (a.dataset.name || '').localeCompare(b.dataset.name || '');
                        case 'rating-desc':
                            return (parseFloat(b.dataset.rating) || 0) - (parseFloat(a.dataset.rating) || 0);
                        default:
                            return 0;
                    }
                });
                
                visibleCards.forEach(card => container.appendChild(card));
            }
            
            function resetFilters() {
                if (filterMinPrice) filterMinPrice.value = filterMinPrice.getAttribute('value') || '';
                if (filterMaxPrice) filterMaxPrice.value = filterMaxPrice.getAttribute('value') || '';
                if (searchInput) searchInput.value = '';
                if (sortOptions) sortOptions.value = 'popularity-desc';
                applyFilters();
                applySort();
            }
            
            // Event listeners
            [filterMinPrice, filterMaxPrice, searchInput].forEach(el => {
                el?.addEventListener('input', () => {
                    applyFilters();
                    applySort();
                });
            });
            
            sortOptions?.addEventListener('change', applySort);
            btnClearFilters?.addEventListener('click', resetFilters);
            btnResetFilters?.addEventListener('click', resetFilters);
            
            // Scroll animation
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, { threshold: 0.1 });
            
            cards.forEach(card => observer.observe(card));
            
            // Initialize
            applyFilters();
        })();
    </script>
    
    <style>
        /* Hero Section */
        .cuisine-province-hero {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            position: relative;
            overflow: hidden;
        }
        
        .hero-bg-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('/images/food-pattern.png') repeat;
            opacity: 0.1;
        }
        
        .cuisine-province-hero .container {
            position: relative;
            z-index: 2;
        }
        
        .breadcrumb-item a {
            text-decoration: none;
        }
        
        /* Statistics */
        .stat-item {
            padding: 1rem;
        }
        
        .stat-value {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 0.25rem;
        }
        
        .stat-label {
            font-size: 0.9rem;
            color: #666;
            margin-bottom: 0.25rem;
        }
        
        /* Cuisine Cards */
        .cuisine-card {
            transition: all 0.3s ease;
            overflow: hidden;
        }
        
        .cuisine-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15) !important;
        }
        
        .cuisine-image {
            width: 100%;
            height: 220px;
            object-fit: cover;
            transition: transform 0.5s ease;
        }
        
        .cuisine-card:hover .cuisine-image {
            transform: scale(1.1);
        }
        
        .price-badge {
            position: absolute;
            top: 15px;
            right: 15px;
            z-index: 10;
        }
        
        .popular-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            z-index: 10;
        }
        
        .rating-stars {
            font-size: 0.9rem;
        }
        
        /* Animations */
        .cuisine-item-card {
            opacity: 0;
            transform: translateY(30px);
            transition: all 0.4s ease;
        }
        
        .cuisine-item-card.visible {
            opacity: 1;
            transform: translateY(0);
        }
        
        /* Star Rating Input */
        .star-rating-input-small {
            display: flex;
            flex-direction: row-reverse;
            justify-content: flex-end;
            gap: 3px;
        }
        
        .star-rating-input-small input[type="radio"] {
            display: none;
        }
        
        .star-rating-input-small .star-label-small {
            font-size: 1.5rem;
            color: #ddd;
            cursor: pointer;
            transition: color 0.2s;
        }
        
        .star-rating-input-small input[type="radio"]:checked ~ .star-label-small,
        .star-rating-input-small .star-label-small:hover,
        .star-rating-input-small .star-label-small:hover ~ .star-label-small {
            color: #ffc107;
        }
        
        /* Responsive */
     
            
            .stat-value {
                font-size: 1.4rem;
            }
        }
    </style>
}
