@using TravelWeb.Models
@model TravelWeb.Models.CuisineProvinceViewModel


@{
    ViewData["Title"] = "Khám phá Ẩm thực Việt Nam";

    // LẤY DỮ LIỆU PHÂN VÙNG (Dictionary<string, List<string>>)
    var provincesByRegion = Model.ProvincesByRegion;

}

<style>
    :root {
        --gold: #e7c27d;
        --gold-dark: #c9a058;
        --brown: #5d3d1a;
        --green: #2f6f55;
        --bg: #faf5ee;
    }

    body {
        background: var(--bg);
    }

    .hero {
        height: 480px;
        border-radius: 0 0 40px 40px;
        position: relative;
        overflow: hidden;
        background: url('https://images.unsplash.com/photo-1504754524776-8f4f37790ca0') center / cover no-repeat;
    }

        .hero::after {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom, rgba(30,20,10,.5), rgba(20,10,5,.8));
        }

    .hero-content {
        position: absolute;
        bottom: 80px;
        width: 100%;
        text-align: center;
        color: white;
        z-index: 2;
    }

        .hero-content h1 {
            font-size: 56px;
            font-weight: 900;
            text-shadow: 0 4px 10px rgba(0,0,0,.5);
        }

    .search-box {
        margin-top: -60px;
        background: white;
        padding: 35px;
        border-radius: 20px;
        max-width: 1000px;
        margin: auto;
        box-shadow: 0 12px 40px rgba(0,0,0,.2);
        position: relative;
        z-index: 10;
    }

    .region-group-title {
        color: var(--brown);
        font-weight: 800;
        font-size: 2rem;
        margin-bottom: 1rem;
        border-left: 5px solid var(--gold-dark);
        padding-left: 15px;
    }

    .province-card {
        position: relative;
        height: 250px;
        border-radius: 22px;
        overflow: hidden;
        transition: .4s;
        box-shadow: 0 5px 20px rgba(0,0,0,.1);
    }

        .province-card:hover {
            transform: scale(1.03);
            box-shadow: 0 18px 50px rgba(0,0,0,.3);
        }

    .province-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: brightness(.6);
    }

    .province-content {
        position: absolute;
        bottom: 0;
        width: 100%;
        padding: 20px;
        color: white;
        background: linear-gradient(to top, rgba(0,0,0,.9), rgba(0,0,0,.1));
    }

    .province-name {
        font-size: 28px;
        font-weight: 900;
        margin-bottom: 5px;
    }

    .province-stat {
        font-size: 15px;
        display: block;
        margin-top: 4px;
    }

    .stat-icon {
        color: var(--gold);
        margin-right: 6px;
    }
</style>

<!-- HERO -->
<section class="hero">
    <div class="hero-content">
        <h1>KHÁM PHÁ ẨM THỰC VIỆT NAM</h1>
        <p>Hành trình qua từng vùng đất – nếm trọn hương vị văn hoá</p>
    </div>
</section>

<!-- SEARCH -->
<div class="search-box container">
    <form method="get" asp-action="Province" asp-controller="Cuisine" class="row g-3">
        <div class="col-md-9">
            <select class="form-select form-select-lg" name="name" required>
                <option value="">-- Chọn Tỉnh / Thành phố --</option>
                @foreach (var p in Model.Provinces.OrderBy(p => p))

                {
                    <option value="@p">@p</option>
                }
            </select>
        </div>
        <div class="col-md-3 d-grid">
            <button class="btn btn-success btn-lg fw-bold">Xem món</button>
        </div>
    </form>
</div>

<!-- CONTENT -->
<div class="container mt-5">

    <h2 class="text-center fw-bold mb-2">
        <i class="bi bi-egg-fried me-2"></i>Thực đơn Vùng miền
    </h2>
    <p class="text-center text-muted mb-4">
        Hơn @Model.Provinces.Count
        tỉnh thành đang chờ bạn khám phá
    </p>

    @if (provincesByRegion != null && provincesByRegion.Any())
    {
        foreach (var region in provincesByRegion)
        {
            <div class="mt-5">
                <h3 class="region-group-title">
                    <i class="bi @CuisineData.GetRegionIcon(region.Key) me-2"></i>
                    @region.Key
                </h3>

                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mt-2">
                    @foreach (var province in region.Value)
                    {
                        var count = CuisineData.GetCountByProvince(province);
                        var veg = CuisineData.GetVegetarianCountByProvince(province);
                        var avgPrice = CuisineData.GetAveragePriceForProvince(province).ToString("N0");

                        string img = $"https://source.unsplash.com/600x400/?vietnam,street-food,{province.Replace(" ", "-")}";

                        <div class="col">
                            <a asp-action="Province" asp-route-name="@province" class="text-decoration-none">
                                <div class="province-card">
                                    <div class="province-bg" style="background-image:url('@img')"></div>

                                    <div class="province-content">
                                        <div class="province-name">@province</div>

                                        <span class="province-stat">
                                            <i class="bi bi-star-fill stat-icon"></i>@count món đặc trưng
                                        </span>

                                        <span class="province-stat">
                                            <i class="bi bi-cash stat-icon"></i>Giá TB: @avgPrice VNĐ
                                        </span>

                                        @if (veg > 0)
                                        {
                                            <span class="province-stat">
                                                <i class="bi bi-flower1 stat-icon"></i>@veg món chay
                                            </span>
                                        }
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="alert alert-warning text-center mt-5">
            Không có dữ liệu vùng miền.
        </div>
    }
</div>
