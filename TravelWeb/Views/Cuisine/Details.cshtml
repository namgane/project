@model CuisineItem
@{
    ViewData["Title"] = Model.Name;
}

<section class="container mt-5">
    <div class="row g-4">

        <div class="col-md-6">
            <img src="@Model.ImageUrl"
                 class="img-fluid rounded-4 shadow"
                 alt="@Model.Name" />
        </div>

        <div class="col-md-6">
            <h1 class="fw-bold">@Model.Name</h1>
            <span class="badge bg-success mb-3">@Model.Region</span>

            <p class="mt-3">@Model.Description</p>

            <h4 class="text-danger mt-3">
                💰 @Model.AveragePrice.ToString("N0") đ
            </h4>

            <p>🔥 Độ phổ biến: <strong>@Model.Popularity</strong></p>

            <p>
                ⭐ @Model.RatingAvg / 5
                (@Model.RatingCount đánh giá)
            </p>

            <a asp-action="Province"
               asp-route-name="@Model.Province"
               class="btn btn-outline-dark mt-3">
                ← Quay lại
            </a>
        </div>
    </div>
</section>
