@{
    ViewData["Title"] = "Câu hỏi du lịch";
    var options = ViewBag.Options as List<string>;
    var key = ViewBag.Key as string;
}

<style>
    /* Custom radio button */
    .option-item input[type=radio] {
        transform: scale(1.3);
        accent-color: #0d6efd; /* Màu xanh đẹp */
    }

    .option-card {
        transition: all 0.2s ease;
        border-radius: 14px !important;
    }

        .option-card:hover {
            background: #f3f9ff;
            transform: translateY(-2px);
            border-color: #0d6efd;
        }

    .header-gradient {
        background: linear-gradient(135deg, #005bea, #00c6fb);
        color: white;
        border-radius: 14px 14px 0 0;
        padding: 25px 25px;
    }

    .question-number {
        font-size: 15px;
        opacity: .9;
    }

    .progress {
        height: 10px;
        border-radius: 10px;
        overflow: hidden;
    }

    .progress-bar {
        background: linear-gradient(to right, #00c6fb, #005bea);
    }

    .travel-card {
        border-radius: 14px;
    }
</style>

<div class="container mt-5">

    <div class="card shadow travel-card mx-auto border-0" style="max-width: 760px;">

        <!-- Header đẹp -->
        <div class="header-gradient">
            <div class="d-flex justify-content-between align-items-center">
                <span class="question-number">
                    Câu hỏi @ViewBag.QuestionIndex / @ViewBag.TotalQuestions
                </span>

                <span class="badge bg-light text-dark px-3 py-2 fs-6 shadow-sm">
                    @((int)ViewBag.QuestionIndex * 100 / (int)ViewBag.TotalQuestions)%
                </span>
            </div>

            <div class="progress mt-3">
                <div class="progress-bar"
                     style="width:@((int)ViewBag.QuestionIndex * 100 / (int)ViewBag.TotalQuestions)%">
                </div>
            </div>
        </div>

        <!-- Nội dung -->
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4 text-dark">
                @ViewBag.Question
            </h3>

            <form method="post" asp-action="Question">
                <input type="hidden" name="key" value="@key" />

                <div class="list-group gap-2 d-flex flex-column">

                    @foreach (var opt in options)
                    {
                        var inputId = ($"opt_{opt}").Replace(" ", "_");

                        <label class="list-group-item option-card border py-3 px-3 d-flex align-items-center option-item"
                               for="@inputId" style="cursor:pointer;">

                            <input class="form-check-input me-3"
                                   type="radio"
                                   name="answer"
                                   value="@opt"
                                   id="@inputId"
                                   required />

                            <span class="fs-5">@opt</span>
                        </label>
                    }

                </div>

                <div class="mt-4 d-flex justify-content-end">
                    <button type="submit"
                            class="btn btn-primary px-4 py-2 fw-semibold shadow-sm"
                            style="border-radius: 10px;">
                        Tiếp tục →
                    </button>
                </div>

            </form>

        </div>

    </div>

</div>
