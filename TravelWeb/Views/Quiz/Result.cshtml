@model List<TravelWeb.Models.Destination>

@{
    ViewData["Title"] = "Kết quả quiz - Điểm đến lý tưởng";

    // Rule labels (giữ nguyên để render explanations)
    var ruleLabels = new Dictionary<string, string>
    {
        {"Region", "Đúng vùng bạn chọn"},
        {"IsCoastalArea", "Có biển như bạn muốn"},
        {"IsMountainArea", "Có núi/trekking"},
        {"LikeHistoricalSites", "Giàu văn hóa/di tích"},
        {"LikeFestival", "Nhiều lễ hội"},
        {"LikeEthnicCulture", "Có văn hóa dân tộc"},
        {"LikeSeafood", "Ẩm thực hải sản"},
        {"LikeSpicyFood", "Hợp khẩu vị cay"},
        {"PreferPeacefulLife", "Không khí yên bình"},
        {"PreferDynamicLife", "Sôi động/hiện đại"},
        {"LikeNatureTour", "Thiên nhiên đẹp"},
        {"LikeCityTour", "Trải nghiệm thành phố/resort"},
        {"ExpectedMood", "Hợp mood chuyến đi"},
        {"BudgetLevel", "Đúng tầm ngân sách"},
        {"TravelSeason", "Đẹp vào mùa bạn chọn"},
        {"TravelDurationDays", "Phù hợp số ngày"},
        {"TravelPace", "Khớp nhịp đi"}
    };

    Func<string, double, double, string> SafeMapUrl = (city, lat, lon) => Url.Action(
        "Index",
        "Map",
        new
        {
            city = city,
            lat = lat.ToString(System.Globalization.CultureInfo.InvariantCulture),
            lng = lon.ToString(System.Globalization.CultureInfo.InvariantCulture)
        });

    // Overall score (fallback to average if not provided)
    var overallScore = ViewBag.OverallScore as double?;
    if (overallScore == null)
    {
        overallScore = Model?.Any() == true ? Math.Round(Model.Average(m => m.NormalizedScore), 1) : 0;
    }

    // Personalized summary (from ViewBag or auto-generate)
    var personalSummary = ViewBag.PersonalSummary as string;
    if (string.IsNullOrWhiteSpace(personalSummary))
    {
        // try to make a short summary from ViewBag.Answers or Model traits
        var answers = ViewBag.Answers as Dictionary<string, object>;
        if (answers != null)
        {
            var mood = answers.ContainsKey("ExpectedMood") ? answers["ExpectedMood"]?.ToString() : null;
            var pref = answers.ContainsKey("PreferPeacefulLife") && (answers["PreferPeacefulLife"]?.ToString() == "True") ? "yên bình" : "";
            personalSummary = $"Hệ thống nhận thấy bạn thích {(!string.IsNullOrEmpty(mood) ? mood : "một chuyến đi hợp mood")}{(pref != "" ? $", không ưa nơi quá ồn ào" : "")}. Các gợi ý ưu tiên phù hợp về thiên nhiên, văn hoá và ngân sách.";
        }
        else
        {
            personalSummary = "Dựa trên câu trả lời quiz, chúng tôi đã gợi ý các điểm đến phù hợp với phong cách và thời gian của bạn.";
        }
    }

    // pick top
    var topPick = Model?.OrderByDescending(m => m.NormalizedScore).FirstOrDefault();

    // Helper function to get unique fallback image for each destination
    Func<string, string> GetUniqueFallbackImage = (destinationName) =>
    {
        // Map each destination to a unique fallback image
        var imageMap = new Dictionary<string, string>
        {
            // Miền Bắc
            {"Hà Nội", "/images/hanoi.jpg"},
            {"Hải Phòng - Hải Dương", "/images/1.1.jpg"},
            {"Quảng Ninh", "/images/1.2.jpg"},
            {"Lào Cai", "/images/1.3.jpg"},
            {"Hà Giang", "/images/1.4.jpg"},
            {"Hưng Yên - Thái Bình", "/images/1.5.jpg"},
            {"Ninh Bình", "/images/2.1.jpg"},
            {"Thanh Hóa", "/images/2.2.jpg"},
            // Miền Trung
            {"Nghệ An", "/images/2.3.jpg"},
            {"Hà Tĩnh", "/images/2.4.jpg"},
            {"Quảng Bình", "/images/2.5.jpg"},
            {"Huế", "/images/3.1.jpg"},
            {"Đà Nẵng", "/images/3.2.jpg"},
            {"Quảng Nam", "/images/3.3.jpg"},
            {"Quảng Ngãi", "/images/3.4.jpg"},
            {"Bình Định", "/images/3.5.jpg"},
            {"Phú Yên", "/images/4.1.jpg"},
            {"Khánh Hòa", "/images/4.2.jpg"},
            {"Ninh Thuận", "/images/4.3.jpg"},
            {"Bình Thuận", "/images/4.4.jpg"},
            // Tây Nguyên
            {"Kon Tum", "/images/slideshow/1.jpg"},
            {"Gia Lai", "/images/slideshow/2.jpg"},
            {"Đắk Lắk", "/images/slideshow/3.jpg"},
            {"Đắk Nông", "/images/slideshow/4.jpg"},
            {"Lâm Đồng", "/images/slideshow/5.jpg"},
            // Miền Nam
            {"TP.HCM - Bình Dương - Bà Rịa", "/images/hcm.jpg"},
            {"Đồng Nai - Bình Phước", "/images/1.1.jpg"},
            {"Tây Ninh", "/images/1.2.jpg"},
            {"Long An", "/images/1.3.jpg"},
            {"Tiền Giang", "/images/1.4.jpg"},
            {"Vĩnh Long", "/images/1.5.jpg"},
            {"Cần Thơ", "/images/2.1.jpg"},
            {"An Giang", "/images/2.2.jpg"},
            {"Kiên Giang", "/images/2.3.jpg"},
            {"Cà Mau", "/images/2.4.jpg"}
        };
        
        // Create a list of all available images for hash-based fallback
        var allAvailableImages = new List<string>();
        foreach (var img in imageMap.Values.Distinct())
        {
            allAvailableImages.Add(img);
        }
        // Add additional images from slideshow
        allAvailableImages.AddRange(new[] {
            "/images/slideshow/1.jpg", "/images/slideshow/2.jpg", "/images/slideshow/3.jpg", 
            "/images/slideshow/4.jpg", "/images/slideshow/5.jpg"
        });

        // Try to find exact match first
        if (imageMap.ContainsKey(destinationName))
        {
            return imageMap[destinationName];
        }

        // Try partial match (case-insensitive)
        var destLower = destinationName.ToLower();
        foreach (var kv in imageMap)
        {
            var keyLower = kv.Key.ToLower();
            if (destLower.Contains(keyLower) || keyLower.Contains(destLower))
            {
                return kv.Value;
            }
        }

        // Default fallback based on hash of name to ensure uniqueness
        var hash = Math.Abs(destinationName.GetHashCode());
        return allAvailableImages[hash % allAvailableImages.Count];
    };
}

