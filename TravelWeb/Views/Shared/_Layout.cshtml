@using Microsoft.AspNetCore.Http
@{
    var username = Context.Session.GetString("Username");
    var role = Context.Session.GetString("Role");
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TravelWeb</title>

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <!-- Site CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TravelWeb.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/festival.css" />

    <!-- Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

    <!-- ===== FIX GOOGLE TRANSLATE + LAYOUT ===== -->
    <style>
        /* 1. Ẩn thanh Google Frame cũ */
        .goog-te-banner-frame,
        iframe.goog-te-banner-frame {
            display: none !important;
        }

        /* 2. Ẩn thanh Google Frame mới (Class bạn vừa tìm thấy) */
        .VIpgJd-ZVi9od-ORHb-OEVmcd {
            display: none !important;
            visibility: hidden !important;
        }

        /* 3. Ẩn theo ID (phòng trường hợp class thay đổi) */
        /* Lưu ý: Cần dùng dấu gạch chéo ngược \ trước dấu : và . vì đó là ký tự đặc biệt trong CSS */
        iframe#\:2\.container {
            display: none !important;
            visibility: hidden !important;
        }

        /* 4. QUAN TRỌNG: Đẩy trang web lên trên cùng */
        /* Google thường thêm style="top: 40px" vào thẻ body, đoạn này sẽ ghi đè nó */
        body {
            position: static !important;
            top: 0px !important;
        }

        /* 5. Ẩn chữ "Được hỗ trợ bởi Google Dịch" */
        .goog-te-gadget span {
            display: none !important;
        }

        .goog-te-gadget {
            color: transparent !important;
        }
    </style>
</head>

<!-- ================= BODY FIX FOOTER ================= -->
<body>

    <!-- ================= HEADER ================= -->
    <header>
        <nav class="navbar navbar-dark fixed-top custom-header">
            <div class="container-fluid d-flex align-items-center justify-content-between px-4">

                <div class="d-flex align-items-center">
                    <button class="btn hamburger-btn me-3"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#sidebarMenu">
                        <i class="bi bi-list fs-2"></i>
                    </button>

                    <a class="navbar-brand d-flex align-items-center"
                       asp-controller="Tours"
                       asp-action="Index">
                        <i class="bi bi-airplane-fill me-2 fs-3 text-white"></i>
                        <span class="fs-3 fw-bold text-white">TravelWeb</span>
                    </a>
                </div>

                <ul class="navbar-nav flex-row align-items-center">
                    @if (string.IsNullOrEmpty(username))
                    {
                        <li class="nav-item me-2">
                            <a class="btn btn-outline-light rounded-pill px-4"
                               asp-controller="Users"
                               asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn custom-btn-register fw-bold rounded-pill px-4"
                               asp-controller="Users"
                               asp-action="Register">Register</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center"
                               data-bs-toggle="dropdown">
                                <div class="avatar-circle me-2">
                                    @username.Substring(0, 1).ToUpper()
                                </div>
                                @username
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="Users"
                                       asp-action="Logout">
                                        <i class="bi bi-box-arrow-right text-danger"></i> Logout
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <!-- ================= SIDEBAR ================= -->
        <div class="offcanvas offcanvas-start custom-sidebar" id="sidebarMenu">
            <div class="offcanvas-header">
                <h5 class="offcanvas-title fw-bold">
                    <i class="bi bi-map-fill me-2"></i> MENU
                </h5>
                <button class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
            </div>

            <div class="offcanvas-body">
                <ul class="nav flex-column sidebar-nav">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Tours" asp-action="Index">
                            <i class="bi bi-house-door"></i> Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="TripPlanner" asp-action="Index">
                            <i class="bi bi-calendar-range"></i> Trip Planner
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Quiz" asp-action="Start">
                            <i class="bi bi-puzzle"></i> AkiCity
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="TikTok" asp-action="Index">
                            <i class="bi bi-tiktok"></i> Search Tiktok
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Festival" asp-action="Index">
                            <i class="bi bi-balloon"></i> Festival
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cuisine" ? "active" : "")" asp-controller="Cuisine" asp-action="Index">
                            <i class="bi bi-egg-fried"></i> Ẩm thực
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Feedback" asp-action="Index">
                            <i class="bi bi-chat-text"></i> Góp ý
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ================= MAIN (ĐẨY FOOTER XUỐNG) ================= -->
    <div id="page-content" style="padding-top:130px; min-height: calc(100vh - 80px);">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white py-4" style="margin-top: auto;">
        <div class="container">
            <div class="row align-items-center">

                <div class="col-md-4 text-center text-md-start mb-3 mb-md-0">
                    <h5 class="fw-bold text-warning mb-1">
                        <i class="bi bi-airplane-fill me-2"></i>TravelWeb
                    </h5>
                    <small class="text-white-50">Khám phá thế giới trong tầm tay bạn.</small>
                </div>

                <div class="col-md-4 text-center mb-3 mb-md-0">
                    <a asp-controller="Tours" asp-action="Index" class="text-white text-decoration-none px-2 small hover-underline">Trang chủ</a>
                    <span class="text-white-50">|</span>
                    <a asp-controller="TripPlanner" asp-action="Index" class="text-white text-decoration-none px-2 small hover-underline">Lập kế hoạch</a>
                    <span class="text-white-50">|</span>
                    <a asp-controller="Feedback" asp-action="Index" class="text-white text-decoration-none px-2 small hover-underline">Góp ý</a>
                </div>

                <div class="col-md-4 text-center text-md-end">
                    <div class="mb-2">
                        <a href="https://www.facebook.com/nam.dua.9" class="text-white me-3"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white me-3"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-white"><i class="bi bi-tiktok"></i></a>
                    </div>
                    <small class="text-white-50">&copy; 2025 TravelWeb. All rights reserved.</small>
                </div>

            </div>
        </div>
    </footer>

    <style>
        .hover-underline:hover {
            text-decoration: underline !important;
            color: #ffc107 !important; /* Màu vàng khi hover */
        }
    </style>

    <!-- ================= GOOGLE TRANSLATE BUTTON ================= -->
    <div id="google_translate_element"
         style="position:fixed;
                bottom:20px;
                left:20px;
                z-index:9999;
                background:#fff;
                padding:6px 12px;
                border-radius:20px;
                box-shadow:0 4px 10px rgba(0,0,0,.25);">
    </div>

    <!-- ================= JS ================= -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <!-- GOOGLE TRANSLATE -->
    <script>
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'vi',
                includedLanguages: 'vi,en,ja,ko,fr,zh-CN',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE
            }, 'google_translate_element');
        }

        // Dọn gadget Google thừa (FIX trắng trang)
        setTimeout(() => {
            document.querySelectorAll('.goog-te-gadget').forEach(el => {
                if (!el.closest('#google_translate_element')) el.remove();
            });
            document.body.style.top = '0px';
        }, 500);
    </script>

    <script src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

</body>
</html>
