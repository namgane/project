@model List<TravelWeb.Models.Festival>

@{
    ViewData["Title"] = "Lễ hội sắp diễn ra";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    int totalItems = ViewBag.TotalItems;
}

<div class="container mt-4">

    <h2 class="text-center text-success mb-4">📅 Lễ hội sắp diễn ra</h2>

    <div class="row">
        @foreach (var fest in Model)
        {
            <div class="col-md-4 mb-4">
                @await Html.PartialAsync("_FestivalCard", fest)
            </div>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="text-center mt-4">
            <ul class="pagination justify-content-center">
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Upcoming", new { page = i })">
                            @i
                        </a>
                    </li>
                }
            </ul>

            <small class="text-muted">
                Trang @currentPage / @totalPages – @totalItems lễ hội
            </small>
        </nav>
    }
</div>
