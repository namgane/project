    </div>

    <!-- PHÂN TRANG -->
    @if (totalPages > 1)
    {
        <div class="pagination-container">
            <ul class="pagination">

                <!-- ĐẦU + TRƯỚC -->
                @if (currentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index",
                            new { page = 1, search = searchTerm, province = selectedProvince, region = selectedRegion, month = selectedMonth })">Đầu</a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index",
                            new { page = currentPage - 1, search = searchTerm, province = selectedProvince, region = selectedRegion, month = selectedMonth })">Trước</a>
                    </li>
                }

                <!-- SỐ TRANG -->
                @for (int i = Math.Max(1, currentPage - 2); i <= Math.Min(totalPages, currentPage + 2); i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index",
                               new { page = i, search = searchTerm, province = selectedProvince, region = selectedRegion, month = selectedMonth })">
                            @i
                        </a>
                    </li>
                }

                <!-- SAU + CUỐI -->
                @if (currentPage < totalPages)
                {
                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index",
                            new { page = currentPage + 1, search = searchTerm, province = selectedProvince, region = selectedRegion, month = selectedMonth })">Sau</a>
                    </li>

                    <li class="page-item">
                        <a class="page-link" href="@Url.Action("Index",
                            new { page = totalPages, search = searchTerm, province = selectedProvince, region = selectedRegion, month = selectedMonth })">Cuối</a>
                    </li>
                }
            </ul>

            <div class="pagination-info">Trang @currentPage / @totalPages</div>
        </div>
    }
</div>

