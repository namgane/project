    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;

    var searchTerm = ViewBag.SearchTerm ?? "";
    var selectedProvince = ViewBag.Province ?? "";
    var selectedRegion = ViewBag.Region ?? "";
    var selectedMonth = ViewBag.Month;

    var allFestivals = TravelWeb.Models.FestivalData.GetAll();
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="hero-bg-container" id="heroBgContainer"></div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>🎉 Lễ Hội Việt Nam</h1>
        <p>Khám phá những lễ hội đặc sắc và đầy màu sắc trên khắp đất nước</p>
    </div>
</section>

<div class="container mt-5">

    <h2 class="text-center mb-4 text-primary">Danh sách lễ hội trên khắp Việt Nam</h2>

    <!-- BỘ LỌC + TÌM KIẾM -->
    <div class="card shadow-sm p-3 mb-4">
        <form method="get" action="@Url.Action("Index")" class="row g-3">

            <!-- Tìm kiếm -->
            <div class="col-md-4">
                <label class="form-label fw-bold">Tìm kiếm</label>
                <input name="search" type="text" class="form-control"
                       placeholder="Tên lễ hội, tỉnh/thành..."
                       value="@searchTerm" />
            </div>

            <!-- Lọc theo tỉnh -->
            <div class="col-md-3">
                <label class="form-label fw-bold">Tỉnh/Thành</label>
                <select name="province" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var p in allFestivals.Select(f => f.Province).Distinct())
                    {
                        if (selectedProvince == p)
                        {
                            <option value="@p" selected="selected">@p</option>
                        }
                        else
                        {
                            <option value="@p">@p</option>
                        }
                    }

                </select>
            </div>


            <!-- Lọc theo tháng -->
            <div class="col-md-2">
                <label class="form-label fw-bold">Tháng</label>
                <select name="month" class="form-select">
                    <option value="">Tất cả</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(selectedMonth == m)">Tháng @m</option>
                    }
                </select>
            </div>


            <!-- Nút -->
            <div class="col-12 text-end mt-2">
                <button class="btn btn-primary px-4">Lọc</button>
                <a href="@Url.Action("Index")" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>

    <!-- Tổng số kết quả -->
    <div class="mb-3 small text-muted">
        Hiển thị @((currentPage - 1) * 6 + 1) – @Math.Min(currentPage * 6, totalItems)
        trong tổng @totalItems lễ hội
    </div>

    <hr />

    <!-- GRID LỄ HỘI -->
