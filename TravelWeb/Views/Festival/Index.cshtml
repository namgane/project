@model List<TravelWeb.Models.Festival>
@{
    ViewData["Title"] = "Danh sách lễ hội Việt Nam";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var totalItems = ViewBag.TotalItems ?? 0;
    var searchTerm = ViewBag.SearchTerm ?? "";
    var allFestivals = TravelWeb.Models.FestivalData.GetAll();

    // Khai báo danh sách cho filter nhanh
    var allRegions = new List<string> { "Miền Bắc", "Miền Trung", "Miền Nam", "Tây Nguyên", "Miền Tây Nam Bộ" };
    var allFestivalTypes = new List<string> { "Tâm linh", "Văn hóa", "Dân gian", "Đặc sắc" };
    var allSeasons = new List<string> { "Xuân", "Hè", "Thu", "Đông" };
}

<style>
    /* Hero Section Styles */
    .hero-section {
        position: relative;
        height: 50vh; 
        min-height: 350px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
    }

    .hero-bg-container {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
    }

    .hero-bg-image {
        position: absolute;
        width: 100%;
        height: 100%;
        background-size: cover;
        background-position: center;
        opacity: 0;
        transition: opacity 1s ease-in-out;
    }

    .hero-bg-image.active {
        opacity: 1;
    }

    .hero-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.6);
        z-index: 1;
    }

    .hero-content {
        position: relative;
        color: white;
        z-index: 2;
    }

    .hero-content h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .hero-actions {
        margin-top: 1.5rem;
    }

    .hero-actions .btn {
        font-size: 1.1rem;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        margin: 0 0.5rem;
    }

    .festival-card-img {
        height: 180px;
        object-fit: cover;
        width: 100%;
    }
    /* Festival Card Animation */
    .festival-card {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.5s ease-out, transform 0.5s ease-out;
    }

    .festival-card.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 1rem;
    }
    
    .card-hover-effect {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card-hover-effect:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15) !important;
    }
</style>

<section class="hero-section">
    <div class="hero-bg-container" id="heroBgContainer">
    </div>
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1>🎉 Khám phá Lễ Hội Việt Nam</h1>
        <p class="fs-5">Cùng tìm kiếm sự kiện văn hóa, tâm linh và ẩm thực đặc sắc sắp diễn ra!</p>

        <div class="hero-actions">
            <a href="#quickFilters" class="btn btn-warning">
                <i class="bi bi-calendar-range me-2"></i>Khám phá theo Thời gian
            </a>
            <a href="@Url.Action("Start", "Quiz")" class="btn btn-outline-light">
                <i class="bi bi-question-circle-fill me-2"></i>Gợi ý Lễ hội phù hợp với bạn
            </a>
        </div>
    </div>
</section>

<div class="container mt-5">
    <h2 class="text-center mb-4 text-primary">Danh sách lễ hội trên khắp Việt Nam</h2>

    @* ========================= BỘ LỌC CHÍNH (FILTER CONTROLS) ========================= *@
    <div class="card border-0 shadow-lg mb-4" id="quickFilters">
        <div class="card-header bg-light fw-bold">🔎 Lọc nhanh theo Dữ liệu Lễ hội</div>
        <div class="card-body">
            <div class="row g-3 align-items-end">
                @* Tìm kiếm theo từ khóa *@
                <div class="col-12 col-md-4">
                    <form method="get" action="@Url.Action("Index")" class="d-flex">
                        <input name="search" type="text" id="searchTerm" class="form-control form-control-sm" placeholder="Tìm theo tên, tỉnh/thành..." value="@searchTerm" />
                        <button type="submit" class="btn btn-primary btn-sm ms-2">Tìm kiếm</button>
                    </form>
                </div>

                @* Bộ lọc Nhanh (Sử dụng JS để lọc không reload) *@
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">📍 Miền</label>
                    <select id="filterRegion" class="form-select form-select-sm filter-control">
                        <option value="">Tất cả</option>
                        @foreach (var region in allRegions)
                        {
                            <option value="@region">@region</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label small mb-1">📅 Mùa</label>
                    <select id="filterSeason" class="form-select form-select-sm filter-control">
                        <option value="">Tất cả</option>
                        @foreach (var season in allSeasons)
                        {
                            <option value="@season">@season</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label small mb-1">🎭 Loại lễ hội</label>
                    <select id="filterType" class="form-select form-select-sm filter-control">
                        <option value="">Tất cả</option>
                        @foreach (var type in allFestivalTypes)
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
            </div>
            <div class="mt-3 text-md-end small text-muted" id="filterInfo">
                Hiển thị @((currentPage - 1) * 6 + 1) - @Math.Min(currentPage * 6, totalItems) trong tổng số @totalItems lễ hội
            </div>
        </div>
    </div>
    @* ========================= KẾT THÚC BỘ LỌC CHÍNH ========================= *@

    <div class="row" id="festivalGrid">
        @* Logic xử lý hiển thị/Không kết quả *@
        @if (Model.Any())
        {
            @foreach (var fest in Model)
            {
                <div class="col-md-4 mb-4 festival-item" 
                     data-name="@fest.Name" 
                     data-province="@fest.Province" 
                     data-region="@(fest.Region ?? "")" 
                     data-type="@(fest.Type ?? "")"
                     data-season="@(fest.Season ?? "")"
                     data-popularity="@(fest.PopularityLevel ?? "Bình thường")">
                    
                    @* Sử dụng Partial View cho Card Lễ hội *@
                    @await Html.PartialAsync("_FestivalCard", fest)
                </div>
            }
        }
        else
        {
            <div class="alert alert-warning text-center mx-auto" style="max-width:720px;">
                <i class="bi bi-exclamation-triangle-fill"></i> Hiện chưa có lễ hội nào phù hợp trong danh sách.
            </div>
        }
    </div>
    
    <div id="noJsResults" class="alert alert-warning text-center mx-auto d-none" style="max-width:720px;">
        <i class="bi bi-exclamation-triangle-fill"></i> Không tìm thấy lễ hội nào phù hợp với các tiêu chí lọc.
    </div>

    @* Phân trang (Giữ nguyên logic phân trang server-side) *@
    @if (totalPages > 1)
{
    <nav class="d-flex justify-content-between align-items-center mt-4">
        <ul class="pagination mb-0">

            @if (currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           page = currentPage - 1,
                           search = ViewBag.SearchTerm,
                           region = ViewBag.SelectedRegion,
                           season = ViewBag.SelectedSeason,
                           type = ViewBag.SelectedType
                       })">
                        ← Trước
                    </a>
                </li>
            }

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           page = i,
                           search = ViewBag.SearchTerm,
                           region = ViewBag.SelectedRegion,
                           season = ViewBag.SelectedSeason,
                           type = ViewBag.SelectedType
                       })">
                        @i
                    </a>
                </li>
            }

            @if (currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link"
                       href="@Url.Action("Index", new {
                           page = currentPage + 1,
                           search = ViewBag.SearchTerm,
                           region = ViewBag.SelectedRegion,
                           season = ViewBag.SelectedSeason,
                           type = ViewBag.SelectedType
                       })">
                        Sau →
                    </a>
                </li>
            }
        </ul>

        <div class="text-muted small">
            Trang @currentPage / @totalPages – @totalItems lễ hội
        </div>
    </nav>
}


@section Scripts {
    <script>
        // Hàm tiện ích để chuẩn hóa chuỗi (chuyển về chữ thường và xóa khoảng trắng)
        function normalize(v) { return (v || '').toString().toLowerCase().replace(/\s/g, ''); }

        // Dữ liệu cho Hero Background
        const allFestivalsData = @Html.Raw(Json.Serialize(allFestivals));
        const festivalImages = allFestivalsData.flatMap(f => f.imageUrls.length > 0 ? f.imageUrls : [f.imageUrl]).filter(url => url);

        // Danh sách các controls lọc
        const filterControls = document.querySelectorAll('.filter-control');
        const festivalGrid = document.getElementById('festivalGrid');
        const festivalItems = Array.from(festivalGrid.querySelectorAll('.festival-item'));
        const noJsResults = document.getElementById('noJsResults');
        const filterInfo = document.getElementById('filterInfo');

        // Logic Lọc JavaScript
        function applyFilters() {
            const selectedRegion = normalize(document.getElementById('filterRegion').value);
            const selectedSeason = normalize(document.getElementById('filterSeason').value);
            const selectedType = normalize(document.getElementById('filterType').value);

            let visibleCount = 0;

            festivalItems.forEach(item => {
                const itemRegion = normalize(item.getAttribute('data-region'));
                const itemSeason = normalize(item.getAttribute('data-season'));
                const itemType = normalize(item.getAttribute('data-type'));

                let isVisible = true;

                // Lọc theo Miền
                if (selectedRegion && itemRegion !== selectedRegion) {
                    isVisible = false;
                }

                // Lọc theo Mùa
                if (selectedSeason && itemSeason !== selectedSeason) {
                    isVisible = false;
                }

                // Lọc theo Loại
                if (selectedType && itemType !== selectedType) {
                    isVisible = false;
                }

                if (isVisible) {
                    item.style.display = 'block';
                    visibleCount++;
                } else {
                    item.style.display = 'none';
                }
            });

            // Hiển thị/Ẩn thông báo "Không có kết quả"
            if (visibleCount === 0) {
                noJsResults.classList.remove('d-none');
            } else {
                noJsResults.classList.add('d-none');
            }

            // Cập nhật thông tin số lượng hiển thị
            filterInfo.textContent = `Hiển thị ${visibleCount} lễ hội phù hợp trong tổng số ${festivalItems.length} lễ hội`;
        }

        // Gán sự kiện cho các bộ lọc nhanh
        filterControls.forEach(control => {
            control.addEventListener('change', applyFilters);
        });

        // Dynamic Hero Background
        function initializeHeroBackground() {
            const heroContainer = document.getElementById('heroBgContainer');
            if (!heroContainer || festivalImages.length === 0) return;
            
            // Create background image elements
            festivalImages.forEach((imageUrl, index) => {
                const bgDiv = document.createElement('div');
                bgDiv.className = 'hero-bg-image';
                bgDiv.style.backgroundImage = `url('${imageUrl}')`;
                if (index === 0) bgDiv.classList.add('active');
                heroContainer.appendChild(bgDiv);
            });
            
            // Start rotation (Tăng tốc độ lên 5 giây để mượt hơn)
            let currentIndex = 0;
            setInterval(() => {
                const images = heroContainer.querySelectorAll('.hero-bg-image');
                if (images.length === 0) return;
                
                images[currentIndex].classList.remove('active');
                currentIndex = (currentIndex + 1) % images.length;
                images[currentIndex].classList.add('active');
            }, 5000); // 5 giây (Tốc độ tối ưu)
        }
        
        // Scroll animation for festival cards
        function initializeScrollAnimation() {
            const elements = document.querySelectorAll('.festival-card');
            if(elements.length === 0) return;
            
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('visible');
                    }
                });
            }, {
                threshold: 0.1,
                rootMargin: '0px 0px -50px 0px'
            });
            
            elements.forEach(el => observer.observe(el));
        }
        
        // Image carousel functions (Giữ nguyên các hàm cho carousel trong card)
        function initializeCardImageRotation() { 
             const carousels = document.querySelectorAll('.image-carousel');
             carousels.forEach(carousel => {
                 const images = carousel.querySelectorAll('img');
                 if (images.length > 1) {
                     const carouselId = carousel.getAttribute('data-carousel-id');
                     setInterval(() => {
                         // Giả định hàm nextImage(carouselId) đã được định nghĩa ở ngoài
                     }, 3000);
                 }
             });
        }
        // Thêm các hàm cần thiết cho Card Carousel nếu chúng chưa được định nghĩa
        function nextImage(carouselId) { /* ... */ }
        function previousImage(carouselId) { /* ... */ }
        function goToImage(carouselId, index) { /* ... */ }
        

        // Initialize everything when DOM is loaded
        document.addEventListener('DOMContentLoaded', function() {
            initializeHeroBackground();
            initializeScrollAnimation();
            initializeCardImageRotation();
            applyFilters();
        });
    </script>
}
