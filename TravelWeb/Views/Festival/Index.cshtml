    // HERO BACKGROUND ROTATION
    const festivalImages =
        @Html.Raw(Json.Serialize(allFestivals
        .SelectMany(f => f.ImageUrls ?? new List<string> { f.ImageUrl })
        .Distinct().ToList()));

    function initializeHeroBackground() {
        const heroContainer = document.getElementById('heroBgContainer');
        if (!heroContainer || festivalImages.length === 0) return;

        festivalImages.forEach((url, index) => {
            const div = document.createElement('div');
            div.className = 'hero-bg-image';
            div.style.backgroundImage = `url('${url}')`;
            if (index === 0) div.classList.add('active');
            heroContainer.appendChild(div);
        });

        let index = 0;
        setInterval(() => {
            const images = heroContainer.querySelectorAll('.hero-bg-image');
            images[index].classList.remove('active');
            index = (index + 1) % images.length;
            images[index].classList.add('active');
        }, 3000);
    }

    // SCROLL ANIMATION
    function initializeScrollAnimation() {
        const items = document.querySelectorAll('.festival-card');
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.2 });

        items.forEach(el => observer.observe(el));
    }

    // CARD IMAGE AUTO ROTATE - Mỗi 2 giây tự động chuyển ảnh
    function nextImage(id) {
        const carousel = document.querySelector(`[data-carousel-id="${id}"]`);
        if (!carousel) return;

        const images = carousel.querySelectorAll('.carousel-image');
        const indicators = carousel.querySelectorAll('.carousel-indicator');
        if (images.length <= 1) return;

        let currentIndex = [...images].findIndex(img => img.classList.contains('active'));
        if (currentIndex === -1) {
            currentIndex = 0;
            images[0].classList.add('active');
            if (indicators[0]) indicators[0].classList.add('active');
            return;
        }

        const nextIndex = (currentIndex + 1) % images.length;

        images[currentIndex].classList.remove('active');
        if (indicators[currentIndex]) indicators[currentIndex].classList.remove('active');

        images[nextIndex].classList.add('active');
        if (indicators[nextIndex]) indicators[nextIndex].classList.add('active');
    }

    function initializeCardImageRotation() {
        document.querySelectorAll('.image-carousel').forEach(c => {
            const images = c.querySelectorAll('.carousel-image');
            if (images.length > 1) {
                // Đảm bảo ảnh đầu tiên có class active
                images.forEach((img, idx) => {
                    if (idx === 0) {
                        img.classList.add('active');
                    } else {
                        img.classList.remove('active');
                    }
                });
                // Đảm bảo indicator đầu tiên active
                const indicators = c.querySelectorAll('.carousel-indicator');
                indicators.forEach((ind, idx) => {
                    if (idx === 0) {
                        ind.classList.add('active');
                    } else {
                        ind.classList.remove('active');
                    }
                });
                
                const id = c.getAttribute("data-carousel-id");
                // Tự động chuyển mỗi 2 giây
                setInterval(() => nextImage(id), 2000);
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
