@model List<TravelWeb.Models.Trip>
@{
    ViewData["Title"] = "Gợi ý chuyến đi đến lễ hội sắp diễn ra";

    // Hàm tiện ích để chọn icon phương tiện
    string GetModeIcon(string mode)
    {
        return mode?.ToLower() switch
        {
            "máy bay" => "bi-airplane-fill",
            "tàu hỏa" => "bi-train-lightrail-front-fill",
            "xe khách" => "bi-bus-fill",
            "ô tô" => "bi-car-front-fill",
            _ => "bi-geo-alt-fill",
        };
    }
}

<div class="passport-hero py-4 mb-4 bg-info text-white shadow-sm">
    <div class="container text-center">
        <h1 class="fw-bold mb-1">🎉 Gợi ý Chuyến Đi Lễ Hội</h1>
        <p class="mb-0 fs-5">Khám phá các sự kiện hấp dẫn trong 3 tháng tới!</p>
    </div>
</div>

<div class="container mb-4">
    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm mx-auto" style="max-width:720px;">
            <div class="card-body text-center">
                <div class="display-6 mb-2">🗓️</div>
                <p class="text-muted mb-0">Hiện chưa có lễ hội nào trong 3 tháng tới.</p>
            </div>
        </div>
    }
    else
    {
        var fromCities = Model.Select(t => t.FromCity).Distinct().OrderBy(x => x).ToList();
        var transportTypes = Model.Select(t => t.TransportType).Distinct().OrderBy(x => x).ToList();

        <div class="card border-0 shadow-lg mb-4">
            <div class="card-header bg-light fw-bold">🔎 Bộ lọc & Tùy chọn hiển thị</div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1">Từ thành phố</label>
                        <select id="filterFromCity" class="form-select form-select-sm">
                            <option value="">Tất cả</option>
                            @foreach (var city in fromCities)
                            {
                                <option value="@city">@city</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1">Phương tiện</label>
                        <select id="filterTransportType" class="form-select form-select-sm">
                            <option value="">Tất cả</option>
                            @foreach (var type in transportTypes)
                            {
                                <option value="@type">@type</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small mb-1">Hiển thị mỗi trang</label>
                        <select id="pageSize" class="form-select form-select-sm">
                            <option value="5">5 mục</option>
                            <option value="10" selected>10 mục</option>
                            <option value="20">20 mục</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-3 d-grid">
                        <button id="btnClearFilters" class="btn btn-outline-secondary btn-sm">Xóa lọc</button>
                    </div>
                </div>
            </div>
        </div>

        <div id="tripList" class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var t in Model)
            {
                <div class="col trip-item" data-fromcity="@t.FromCity" data-transport="@t.TransportType">
                    <div class="card shadow-sm h-100 border-0">
                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="card-title fw-bold text-primary mb-0">
                                    <i class="bi bi-pin-map-fill me-1"></i> @t.ToProvince
                                </h5>
                                <span class="fs-5 fw-bolder text-danger">@t.Price.ToString("N0") <small class="text-muted">VNĐ</small></span>
                            </div>

                            <div class="row g-2 small mb-3 border-bottom pb-3">
                                <div class="col-12 col-sm-6">
                                    <i class="bi @GetModeIcon(t.TransportType) me-1 text-info"></i> Phương tiện: **@t.TransportType**
                                </div>
                                <div class="col-12 col-sm-6 text-sm-end">
                                    <i class="bi bi-calendar-check me-1 text-info"></i> Ngày đi: **@t.DepartureDate.ToString("dd/MM/yyyy")**
                                </div>
                                <div class="col-12">
                                    <i class="bi bi-geo-alt me-1 text-muted"></i> Khởi hành từ: **@t.FromCity**
                                </div>
                            </div>

                            <div class="mt-auto">
                                <p class="mb-2 fw-semibold">
                                    Tham dự lễ hội:
                                    <a href="@Url.Action("Details", "Festival", new { name = t.FestivalName })" class="link-primary fw-bold">@t.FestivalName</a>
                                </p>
                                <a href="@Url.Action("Suggest", "Transport", new { from = t.FromCity, to = t.ToProvince })" class="btn btn-success w-100">
                                    <i class="bi bi-ticket-fill"></i> Xem chi tiết & Đặt vé
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div id="noResults" class="alert alert-warning text-center mt-4 d-none">
            <i class="bi bi-exclamation-triangle-fill"></i> Không tìm thấy chuyến đi nào phù hợp với bộ lọc.
        </div>

        <nav class="mt-4">
            <ul class="pagination justify-content-center" id="pager"></ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        (function(){
            const tripList = document.getElementById('tripList');
            if(!tripList) return;

            const items = Array.from(tripList.querySelectorAll('.trip-item'));
            const pager = document.getElementById('pager');
            const pageSizeSel = document.getElementById('pageSize');
            const filterFromCity = document.getElementById('filterFromCity');
            const filterTransportType = document.getElementById('filterTransportType');
            const btnClear = document.getElementById('btnClearFilters');
            const noResults = document.getElementById('noResults');

            let page = 1;
            let filteredItems = [...items]; // Danh sách các mục đã qua lọc

            function normalize(v){ return (v||'').toString().toLowerCase(); }

            function applyFilters(){
                const city = normalize(filterFromCity && filterFromCity.value);
                const transport = normalize(filterTransportType && filterTransportType.value);

                filteredItems = items.filter(item => {
                    const itemCity = normalize(item.getAttribute('data-fromcity'));
                    const itemTransport = normalize(item.getAttribute('data-transport'));
                    let ok = true;

                    if (city && itemCity !== city) ok = false;
                    if (transport && itemTransport !== transport) ok = false;

                    return ok;
                });

                page = 1; // Reset về trang 1 sau khi lọc
                render();

                // Hiển thị/Ẩn thông báo "Không có kết quả"
                if (filteredItems.length === 0) {
                    noResults.classList.remove('d-none');
                } else {
                    noResults.classList.add('d-none');
                }
            }

            function getPageSize(){ return Number(pageSizeSel.value) || 10; }
            function totalPages(){ return Math.max(1, Math.ceil(filteredItems.length / getPageSize())); }

            function render(){
                const size = getPageSize();
                const start = (page - 1) * size;
                const end = start + size;

                // Ẩn tất cả các mục ban đầu
                items.forEach(tr => tr.style.display = 'none');

                // Chỉ hiển thị các mục đã lọc nằm trong phạm vi trang hiện tại
                filteredItems.forEach((item, idx) => {
                    item.style.display = (idx >= start && idx < end) ? '' : 'none';
                });

                renderPager();
            }

            function renderPager(){
                const pages = totalPages();
                pager.innerHTML = '';

                // Ẩn thanh phân trang nếu chỉ có 1 trang
                if (pages <= 1) return;

                function add(label, targetPage, disabled, active){
                    const li = document.createElement('li');
                    li.className = 'page-item' + (disabled ? ' disabled' : '') + (active ? ' active' : '');
                    const a = document.createElement('a');
                    a.className = 'page-link';
                    a.href = '#';
                    a.textContent = label;
                    a.addEventListener('click', function(e){ e.preventDefault(); if(!disabled && !active){ page = targetPage; render(); }});
                    li.appendChild(a); pager.appendChild(li);
                }

                add('«', 1, page === 1, false);
                add('‹', Math.max(1, page - 1), page === 1, false);

                // Hiển thị các nút số trang
                const maxVisiblePages = 5; // Số nút số trang tối đa hiển thị
                let startPage = Math.max(1, page - Math.floor(maxVisiblePages / 2));
                let endPage = Math.min(pages, startPage + maxVisiblePages - 1);

                if (endPage - startPage + 1 < maxVisiblePages) {
                    startPage = Math.max(1, endPage - maxVisiblePages + 1);
                }

                for(let i = startPage; i <= endPage; i++) add(String(i), i, false, i === page);

                add('›', Math.min(pages, page + 1), page === pages, false);
                add('»', pages, page === pages, false);
            }

            // Gán sự kiện cho các bộ lọc
            [filterFromCity, filterTransportType].forEach(el => el && el.addEventListener('change', applyFilters));

            // Gán sự kiện cho PageSize
            pageSizeSel.addEventListener('change', function(){ page = 1; render(); });

            // Gán sự kiện cho nút "Xóa lọc"
            if (btnClear) btnClear.addEventListener('click', function(){
                if (filterFromCity) filterFromCity.value = '';
                if (filterTransportType) filterTransportType.value = '';
                applyFilters();
            });

            // Chạy lần đầu tiên để thiết lập trạng thái ban đầu
            applyFilters();
        })();
    </script>
}