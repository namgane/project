@model List<TravelWeb.Models.Favorite>
@{
    ViewData["Title"] = "Bộ sưu tập của tôi";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">
            <i class="bi bi-bookmark-heart me-2 text-primary"></i>Bộ sưu tập của tôi
        </h2>
        <div class="d-flex gap-2">
            <a asp-controller="ActivityHistory" asp-action="Index" class="btn btn-outline-info">
                <i class="bi bi-clock-history"></i> Lịch sử hoạt động
            </a>
            <a asp-controller="Cuisine" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-egg-fried"></i> Khám phá Ẩm thực
            </a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-1 mb-3">📚</div>
                <h5 class="fw-bold mb-2">Chưa có mục nào trong bộ sưu tập</h5>
                <p class="text-muted mb-4">Hãy lưu món ăn hoặc hoạt động bạn yêu thích!</p>
                <a asp-controller="Cuisine" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-search"></i> Khám phá ngay
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 rounded-4">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" 
                                 class="card-img-top" 
                                 alt="@item.Title" 
                                 style="height: 200px; object-fit: cover;"
                                 onerror="this.src='/images/default-food.jpg'" />
                        }
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title mb-2">@item.Title</h5>
                            @if (!string.IsNullOrEmpty(item.Subtitle))
                            {
                                <p class="text-muted small mb-3">@item.Subtitle</p>
                            }
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-primary me-2">@item.Type</span>
                                <small class="text-muted">
                                    <i class="bi bi-calendar"></i> @item.CreatedAt.ToString("dd/MM/yyyy")
                                </small>
                            </div>
                            <div class="mt-auto d-flex gap-2">
                                @if (!string.IsNullOrEmpty(item.Url))
                                {
                                    <a href="@item.Url" class="btn btn-sm btn-outline-primary flex-grow-1">
                                        <i class="bi bi-box-arrow-up-right"></i> Mở
                                    </a>
                                }
                                <form method="post" asp-action="Remove" asp-controller="Favorites" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
